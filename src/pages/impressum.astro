---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const email = site.email || '[[E-MAIL]]';
---

<Base
  title="Impressum | Fandrich GmbH — Tischlerei Berlin Pankow"
  description="Impressum der Fandrich GmbH, Tischlerei und Möbelrestaurierung in Berlin-Pankow."
>
  <Nav client:load solid />
  <main class="legal">
    <div class="wrap">
      <p class="eyebrow">Rechtliches</p>
      <h1 class="headline">Impressum</h1>

      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        Tischlerei {site.name}<br />
        {site.street}<br />
        {site.zip} {site.city}
      </p>

      <h2>Vertreten durch</h2>
      <p>Geschäftsführer: [[GESCHÄFTSFÜHRER]]</p>

      <h2>Kontakt</h2>
      <p>
        Telefon: {site.phone}<br />
        E-Mail: {email}
      </p>

      <h2>Registereintrag</h2>
      <p>
        Eingetragen im Handelsregister.<br />
        Registergericht: [[REGISTERGERICHT, z. B. Amtsgericht Charlottenburg]]<br />
        Registernummer: [[HRB-NUMMER]]
      </p>

      <h2>Umsatzsteuer-ID</h2>
      <p>
        Umsatzsteuer-Identifikationsnummer gemäß § 27a UStG:<br />
        [[UST-IDNR — falls nicht vorhanden, diesen Abschnitt entfernen]]
      </p>

      <h2>Berufsrechtliche Angaben</h2>
      <p>
        Gesetzliche Berufsbezeichnung: Tischler (verliehen in der Bundesrepublik Deutschland).<br />
        Zuständige Kammer / Eintragung in die Handwerksrolle:<br />
        Handwerkskammer Berlin, Blücherstraße 68, 10961 Berlin.<br />
        [[HANDWERKSROLLE: Eintragung/Betriebsnummer bestätigen]]
      </p>

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>
        [[VERANTWORTLICHE-PERSON]]<br />
        {site.street}, {site.zip} {site.city}
      </p>

      <h2>Verbraucherstreitbeilegung</h2>
      <p>
        Die frühere EU-Plattform zur Online-Streitbeilegung (OS-Plattform) wurde zum 20. Juli 2025
        eingestellt; ein Link darauf ist daher nicht mehr erforderlich.
      </p>
      <p>
        Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer
        Verbraucherschlichtungsstelle im Sinne des Verbraucherstreitbeilegungsgesetzes (§§ 36, 37
        VSBG) teilzunehmen.
      </p>

      <h2>Bildnachweise</h2>
      <p>
        Projekt- und Werkstattfotos: eigenes Material der Tischlerei {site.name}.
        [[BILDNACHWEISE: Falls Fremd- oder KI-Material verwendet wird, Quelle/Lizenz hier ergänzen.]]
      </p>

      <p class="legal__cross">
        Siehe auch: <a href={`${base}/datenschutz`} class="link-line">Datenschutz</a> ·
        <a href={`${base}/agb`} class="link-line">AGB</a>
      </p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    padding-block: clamp(8rem, 18vh, 12rem) var(--section-gap);
  }
  .legal h2 {
    font-size: 1.3rem;
    margin-top: 2.5rem;
  }
  .legal p {
    margin-top: 0.75rem;
    max-width: 68ch;
    line-height: 1.6;
  }
  .legal__cross {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--oak-line);
  }
</style>
