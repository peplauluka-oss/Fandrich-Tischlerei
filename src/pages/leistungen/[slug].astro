---
/**
 * SEO-Unterseite je Leistung — editoriales Split-Screen-Layout.
 * Links: sticky Titel + Kurzbeschreibung + CTA. Rechts: Leistungsfoto
 * (Parallax) und der ausführliche, indexierbare Text in ruhigen Blöcken.
 * Reveals laufen über das globale .reveal/.split-System (stage.ts).
 */
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav';
import { site } from '../../data/site';
import { leistungen, ablauf } from '../../data/leistungen';
import { leistungenImages } from '../../data/images';

export function getStaticPaths() {
  return leistungen.map((l, i) => ({
    params: { slug: l.slug },
    props: { l, prev: leistungen[(i + leistungen.length - 1) % leistungen.length], next: leistungen[(i + 1) % leistungen.length] },
  }));
}

const { l, next } = Astro.props;
const bild = leistungenImages[l.slug];
const title = l.seoTitle;
const description = l.seoDescription;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Absolute URLs für die strukturierten Daten
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL(base + '/', Astro.site).href;

// Fließtext in ruhige Absätze (je Satz ein Block) für editorialen Rhythmus.
const absaetze = l.text.split(/(?<=\.)\s+/).filter(Boolean);

// Verwandte Leistungen (interne Verlinkung, Ankertext = Keyword)
const verwandtL = l.verwandt
  .map((s) => leistungen.find((x) => x.slug === s))
  .filter((x): x is (typeof leistungen)[number] => Boolean(x));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${l.titel} — Tischlerei Fandrich`,
    serviceType: l.titel,
    description: l.kurz,
    provider: {
      '@type': 'Carpenter',
      '@id': `${Astro.site?.href}#business`,
      name: `Tischlerei ${site.name}`,
    },
    areaServed: { '@type': 'City', name: 'Berlin' },
    url: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: 'Leistungen', item: `${homeUrl}#leistungen-v4` },
      { '@type': 'ListItem', position: 3, name: l.titel, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: l.faq.map((q) => ({
      '@type': 'Question',
      name: q.frage,
      acceptedAnswer: { '@type': 'Answer', text: q.antwort },
    })),
  },
];
---

<Base title={title} description={description} noindex={false} schema={schema}>
  <Nav client:load solid />
  <main class="lp">
    <div class="wrap lp__grid">
      <!-- Links: sticky -->
      <aside class="lp__aside">
        <a href={`${base}/#leistungen-v4`} class="lp__back" data-cursor="link">
          <span aria-hidden="true">←</span> Alle Leistungen
        </a>

        <p class="lp__nr" aria-hidden="true">{l.nr}</p>
        <h1 class="lp__title split">{l.titel}</h1>
        <p class="lp__lead reveal">{l.kurz}</p>

        <div class="lp__cta reveal">
          <a href={`${base}/#kontakt-v4`} class="btn btn--oak" data-cursor="link" data-magnetic="0.3">
            {l.titel} anfragen <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href={`tel:${site.phoneHref}`} class="lp__tel" data-cursor="link">
            oder anrufen: <strong>{site.phone}</strong>
          </a>
        </div>
      </aside>

      <!-- Rechts: Foto + Fließtext -->
      <div class="lp__content">
        <figure class="lp__figure reveal" data-plx>
          <Image
            src={bild.src}
            alt={bild.alt}
            widths={[480, 760, bild.src.width]}
            sizes="(min-width: 900px) 46vw, 92vw"
            quality={80}
          />
          <figcaption class="lp__cap">{bild.caption}</figcaption>
        </figure>

        <div class="lp__prose">
          {absaetze.map((p) => <p class="lp__p reveal">{p}</p>)}
        </div>

        <ul class="lp__tags reveal" aria-label="Auf einen Blick">
          {l.stichworte.map((s) => <li>{s}</li>)}
        </ul>

        {/* Unterleistungen — je H2-Block, indexierbarer Fließtext */}
        <div class="lp__sub">
          {
            l.unterleistungen.map((u) => (
              <section class="lp__subitem reveal">
                <h2 class="lp__h2">{u.titel}</h2>
                <p class="lp__p">{u.text}</p>
              </section>
            ))
          }
        </div>

        {
          l.b2b && (
            <section class="lp__b2b reveal" aria-label={l.b2b.titel}>
              <h2 class="lp__h2">{l.b2b.titel}</h2>
              <p class="lp__p">{l.b2b.text}</p>
              <ul class="lp__b2b-list">
                {l.b2b.punkte.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </section>
          )
        }

        {/* So läuft's ab */}
        <section class="lp__ablauf reveal" aria-label="So läuft es ab">
          <h2 class="lp__h2">So läuft's ab</h2>
          <ol class="lp__steps">
            {
              ablauf.map((s, i) => (
                <li class="lp__step">
                  <span class="lp__step-nr" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="lp__step-t">{s.titel}</h3>
                    <p class="lp__step-d">{s.text}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        {/* Mini-FAQ (deckungsgleich mit FAQPage-Schema) */}
        <section class="lp__faq reveal" aria-label="Häufige Fragen">
          <h2 class="lp__h2">Häufige Fragen</h2>
          <dl class="lp__faqlist">
            {
              l.faq.map((q) => (
                <div class="lp__qa">
                  <dt class="lp__q">{q.frage}</dt>
                  <dd class="lp__a">{q.antwort}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        {/* Einsatzgebiet */}
        <section class="lp__geo reveal" aria-label="Einsatzgebiet">
          <h2 class="lp__h2">Einsatzgebiet</h2>
          <p class="lp__p">{l.einsatzgebiet}</p>
        </section>

        {/* CTA-Wiederholung nach dem Content */}
        <section class="lp__cta lp__cta--end reveal">
          <a href={`${base}/#kontakt-v4`} class="btn btn--oak" data-cursor="link" data-magnetic="0.3">
            {l.titel} anfragen <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href={`tel:${site.phoneHref}`} class="lp__tel" data-cursor="link">
            oder anrufen: <strong>{site.phone}</strong>
          </a>
        </section>

        {/* Interne Verlinkung — Ankertext = Keyword */}
        {
          verwandtL.length > 0 && (
            <nav class="lp__verwandt reveal" aria-label="Verwandte Leistungen">
              <h2 class="lp__h2">Passt dazu</h2>
              <ul class="lp__verwandt-list">
                {verwandtL.map((v) => (
                  <li>
                    <a href={`${base}/leistungen/${v.slug}`} class="lp__vlink" data-cursor="link">
                      {v.titel} <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <a href={`${base}/leistungen/${next.slug}`} class="lp__next" data-cursor="link">
          <span class="lp__next-label">Nächste Leistung</span>
          <span class="lp__next-titel">{next.titel} <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </main>
</Base>

<style>
  .lp {
    padding-top: clamp(6rem, 14vh, 9rem);
    padding-bottom: clamp(4rem, 10vh, 7rem);
  }
  .lp__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* Links: sticky Typo */
  .lp__aside {
    position: sticky;
    top: clamp(6rem, 14vh, 8rem);
  }
  .lp__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(58, 42, 28, 0.75);
    text-decoration: none;
    transition: color 0.25s var(--ease-out);
  }
  .lp__back:hover {
    color: var(--oak);
  }
  .lp__nr {
    margin-top: clamp(1.5rem, 4vh, 2.5rem);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    color: var(--oak);
  }
  .lp__title {
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2.1rem, 4vw, 3.3rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    color: var(--wood-ink);
    overflow-wrap: break-word;
  }
  .lp__lead {
    margin-top: 1rem;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.4;
    color: rgba(58, 42, 28, 0.82);
    max-width: 34ch;
  }
  .lp__cta {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }
  .lp__tel {
    text-decoration: none;
    color: rgba(58, 42, 28, 0.82);
    border-bottom: 1px solid var(--oak-line);
    padding-bottom: 2px;
    transition: border-color 0.25s var(--ease-out);
  }
  .lp__tel:hover {
    border-color: var(--oak);
  }

  /* Rechts: Foto + Text */
  .lp__figure {
    position: relative;
    margin: 0;
    border-radius: clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
    aspect-ratio: 16 / 11;
    box-shadow: 0 34px 60px -34px rgba(28, 18, 10, 0.5);
  }
  .lp__figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  .lp__cap {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    padding: 1.4rem 1.2rem 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--paper);
    background: linear-gradient(0deg, rgba(12, 8, 4, 0.7), transparent);
  }

  .lp__prose {
    margin-top: clamp(2rem, 5vh, 3rem);
  }
  .lp__p {
    font-size: clamp(1.08rem, 1.5vw, 1.3rem);
    line-height: 1.62;
    color: rgba(48, 34, 22, 0.9);
    max-width: 60ch;
  }
  .lp__p + .lp__p {
    margin-top: 1.1rem;
  }

  /* Gemeinsame Abschnitts-Überschrift */
  .lp__h2 {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--wood-ink);
    text-wrap: balance;
  }

  .lp__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: clamp(1.5rem, 4vh, 2.25rem);
  }
  .lp__tags li {
    font-size: 0.85rem;
    color: rgba(48, 34, 22, 0.85);
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--oak-line);
    border-radius: 999px;
    background: rgba(255, 251, 244, 0.5);
  }

  /* Unterleistungen */
  .lp__sub {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    display: grid;
    gap: clamp(1.75rem, 4vh, 2.75rem);
  }
  .lp__subitem .lp__p {
    margin-top: 0.7rem;
  }

  /* B2B-Block */
  .lp__b2b {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: clamp(1rem, 2vw, 1.4rem);
    background: rgba(255, 251, 244, 0.6);
    border: 1px solid var(--oak-line);
  }
  .lp__b2b .lp__p {
    margin-top: 0.7rem;
  }
  .lp__b2b-list {
    list-style: none;
    margin-top: 1.1rem;
    display: grid;
    gap: 0.55rem;
  }
  .lp__b2b-list li {
    position: relative;
    padding-left: 1.5rem;
    line-height: 1.5;
    color: rgba(48, 34, 22, 0.9);
  }
  .lp__b2b-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--oak);
    font-weight: 700;
  }

  /* So läuft's ab */
  .lp__ablauf,
  .lp__faq,
  .lp__geo,
  .lp__verwandt {
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }
  .lp__steps {
    list-style: none;
    margin-top: 1.4rem;
    display: grid;
    gap: 1.1rem;
  }
  .lp__step {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .lp__step-nr {
    flex: 0 0 auto;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--oak);
    padding-top: 0.2rem;
  }
  .lp__step-t {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--wood-ink);
  }
  .lp__step-d {
    margin-top: 0.2rem;
    line-height: 1.55;
    color: rgba(48, 34, 22, 0.82);
    max-width: 54ch;
  }

  /* FAQ */
  .lp__faqlist {
    margin-top: 1.4rem;
    display: grid;
    gap: 1.1rem;
  }
  .lp__qa {
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--oak-line);
  }
  .lp__qa:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .lp__q {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--wood-ink);
  }
  .lp__a {
    margin-top: 0.4rem;
    margin-inline-start: 0;
    line-height: 1.55;
    color: rgba(48, 34, 22, 0.82);
    max-width: 58ch;
  }
  .lp__geo .lp__p {
    margin-top: 0.7rem;
    max-width: 58ch;
  }

  /* Zweiter CTA nach dem Content */
  .lp__cta--end {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* Verwandte Leistungen */
  .lp__verwandt-list {
    list-style: none;
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
  }
  .lp__vlink {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--oak-line);
    background: rgba(255, 251, 244, 0.5);
    color: var(--wood-ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition:
      border-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out);
  }
  .lp__vlink:hover {
    border-color: var(--oak);
    color: var(--oak);
  }

  .lp__next {
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: clamp(3rem, 7vh, 5rem);
    text-decoration: none;
    color: var(--wood-ink);
  }
  .lp__next-label {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(58, 42, 28, 0.6);
  }
  .lp__next-titel {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    letter-spacing: -0.02em;
    transition: color 0.25s var(--ease-out);
  }
  .lp__next:hover .lp__next-titel {
    color: var(--oak);
  }

  @media (max-width: 899px) {
    .lp__grid {
      grid-template-columns: 1fr;
      gap: clamp(1.75rem, 6vw, 2.5rem);
    }
    .lp__aside {
      position: static;
    }
  }
</style>
