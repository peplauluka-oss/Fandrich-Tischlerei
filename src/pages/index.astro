---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav';
import HeroV4 from '../components/HeroV4.astro';
import UeberUnsV4 from '../components/UeberUnsV4.astro';
import LeistungenV4 from '../components/LeistungenV4.astro';
import ArbeitenV4 from '../components/ArbeitenV4.astro';
import WerkstattV4 from '../components/WerkstattV4.astro';
import PartnerV4 from '../components/PartnerV4.astro';
import FaqV4 from '../components/FaqV4.astro';
import StimmenV4 from '../components/StimmenV4.astro';
import CtaBand from '../components/CtaBand.astro';
import KontaktV4 from '../components/KontaktV4.astro';
import { fragen } from '../data/faq';

const title = 'Tischlerei Berlin-Pankow · Meisterbetrieb | Fandrich';
const description =
  'Meistertischlerei in Berlin und Umgebung: Möbel nach Maß, Fenster, Türen, Restaurierung & Reparatur — aus eigener Werkstatt in Pankow. Antwort binnen 24 h.';

// FAQPage-Schema aus derselben Quelle wie das sichtbare Accordion.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: fragen.map((q) => ({
    '@type': 'Question',
    name: q.frage,
    acceptedAnswer: { '@type': 'Answer', text: q.antwort },
  })),
};
---

<Base title={title} description={description} schema={faqSchema}>
  <Nav client:load />
  <main>
    <HeroV4 />
    <UeberUnsV4 />
    <LeistungenV4 />
    <ArbeitenV4 />
    <WerkstattV4 />
    <PartnerV4 />
    <FaqV4 />
    <StimmenV4 />
    <CtaBand />
    <KontaktV4 />
  </main>
</Base>
