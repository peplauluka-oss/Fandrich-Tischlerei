---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav';
import HeroV4 from '../components/HeroV4.astro';
import UeberUnsV4 from '../components/UeberUnsV4.astro';
import LeistungenV4 from '../components/LeistungenV4.astro';
import ArbeitenV4 from '../components/ArbeitenV4.astro';
import WerkstattV4 from '../components/WerkstattV4.astro';
import ProzessV4 from '../components/ProzessV4.astro';
import FaqV4 from '../components/FaqV4.astro';
import CtaBand from '../components/CtaBand.astro';
import KontaktV4 from '../components/KontaktV4.astro';

const title = 'Tischlerei Berlin Pankow — Möbel nach Maß & Restaurierung | Fandrich GmbH';
const description =
  'Meistertischlerei in Berlin-Pankow: Einbaumöbel nach Maß, Möbelrestaurierung und Innenausbau — gefertigt in der eigenen Werkstatt.';
---

<Base title={title} description={description}>
  <Nav client:load />
  <main>
    <HeroV4 />
    <UeberUnsV4 />
    <LeistungenV4 />
    <ArbeitenV4 />
    <WerkstattV4 />
    <ProzessV4 />
    <FaqV4 />
    <CtaBand />
    <KontaktV4 />
  </main>
</Base>
