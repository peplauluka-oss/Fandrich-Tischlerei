---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav';
import HeroV3 from '../components/HeroV3.astro';
import UeberUns from '../components/UeberUns.astro';
import Leistungen from '../components/Leistungen.astro';
import ArbeitenV3 from '../components/ArbeitenV3.astro';
import Werkstatt from '../components/Werkstatt.astro';
import Prozess from '../components/Prozess.astro';
import Kontakt from '../components/Kontakt.astro';

const title = 'Tischlerei Berlin Pankow — Möbel nach Maß & Restaurierung | Fandrich GmbH';
const description =
  'Meistertischlerei in Berlin-Pankow: Einbaumöbel nach Maß, Möbelrestaurierung und Innenausbau — gefertigt in der eigenen Werkstatt.';
---

<Base title={title} description={description}>
  <Nav client:load />
  <main>
    <HeroV3 />
    <UeberUns />
    <Leistungen />
    <ArbeitenV3 />
    <Werkstatt />
    <Prozess />
    <Kontakt />
  </main>
</Base>
