---
// BILDLOS (Bild-Gesetz dieser Runde). Editorial-Liste im Stil einer
// Manufaktur-Preisliste: riesige Fraunces-Nummer links, rechts Titel, Text
// und eine Stichwort-Zeile. Texte unverändert, nichts dazuerfunden.
const leistungen = [
  {
    nr: '01',
    titel: 'Neuanfertigung',
    text: 'Einbauschränke, Küchen und Bibliotheken, entworfen für Ihren Raum. Gefertigt aus Massivholz und ausgesuchten Furnieren — vom Aufmaß bis zur letzten Fuge.',
    stichworte: ['Einbauschränke', 'Küchen', 'Bibliotheken', 'Massivholz'],
  },
  {
    nr: '02',
    titel: 'Restaurierung',
    text: 'Wir setzen Möbel mit Geschichte instand — mit Schellackpolitur, traditionellen Leimen und Respekt vor der Substanz. Was Ihre Familie geprägt hat, bleibt erhalten.',
    stichworte: ['Schellackpolitur', 'traditionelle Leime', 'Furnierbild'],
  },
  {
    nr: '03',
    titel: 'Innenausbau & Reparatur',
    text: 'Türen, Dielung, Fensterinstandsetzung und Balkonverglasung im Berliner Altbau. Präzise Reparaturen, die man am Ende nicht mehr sieht.',
    stichworte: ['Türen', 'Dielung', 'Fensterinstandsetzung', 'Balkonverglasung'],
  },
];
---

<section class="section leistungen" id="leistungen-v3" aria-label="Leistungen">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(02)</span>Unsere Leistungen</p>
      <h2 class="headline split">Wie wir Ihnen helfen.</h2>
    </div>

    <ul class="lst">
      {
        leistungen.map((l, i) => (
          <li class="lst__row reveal" style={`--reveal-delay: ${i * 0.08}s`}>
            <span class="lst__nr" aria-hidden="true">
              {l.nr}
            </span>
            <div class="lst__body">
              <h3 class="lst__titel">{l.titel}</h3>
              <p class="lst__text">{l.text}</p>
              <p class="lst__tags">
                {l.stichworte.map((s, k) => (
                  <>
                    {k > 0 && <span class="lst__dot" aria-hidden="true">·</span>}
                    <span>{s}</span>
                  </>
                ))}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lst {
    list-style: none;
    margin-top: clamp(3rem, 7vh, 5rem);
  }

  /* Asymmetrisch: riesige Nummer links, leicht aus dem Raster geschoben */
  .lst__row {
    display: grid;
    grid-template-columns: minmax(5rem, 9rem) 1fr;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: baseline;
    padding-block: clamp(2.25rem, 5vh, 3.75rem);
    border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .lst__row:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .lst__nr {
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(4.5rem, 11vw, 10rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--ink) 20%, transparent);
    margin-left: clamp(-0.5rem, -1vw, -1.25rem);
    transition: color 0.5s var(--ease-out);
    -webkit-user-select: none;
    user-select: none;
  }

  .lst__titel {
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    transition: transform 0.5s var(--ease-out);
  }

  .lst__text {
    margin-top: 1rem;
    color: var(--ink-soft);
    max-width: 54ch;
  }

  .lst__tags {
    margin-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.7rem;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .lst__dot {
    color: var(--oak);
  }

  /* Hover (Desktop): Nummer färbt von --ink/20 zu --oak, Titel wandert leicht */
  @media (hover: hover) {
    .lst__row:hover .lst__nr {
      color: var(--oak);
    }
    .lst__row:hover .lst__titel {
      transform: translateX(0.5rem);
    }
  }

  @media (max-width: 720px) {
    .lst__row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      align-items: start;
    }
    .lst__nr {
      font-size: clamp(3.5rem, 22vw, 6rem);
      margin-left: 0;
    }
  }
</style>
