---
import { Image } from 'astro:assets';
import kueche from '../assets/images/IMG_2479.jpeg';
import bibliothek from '../assets/images/IMG_2480.jpeg';
import loft from '../assets/images/IMG_2475.jpeg';

const leistungen = [
  {
    nr: '01',
    titel: 'Neuanfertigung',
    text: 'Einbauschränke, Küchen und Bibliotheken, entworfen für Ihren Raum. Gefertigt aus Massivholz und ausgesuchten Furnieren — vom Aufmaß bis zur letzten Fuge.',
    bild: kueche,
    alt: 'Einbauküche mit Kochinsel als Beispiel für Neuanfertigung',
  },
  {
    nr: '02',
    titel: 'Restaurierung',
    text: 'Wir setzen Möbel mit Geschichte instand — mit Schellackpolitur, traditionellen Leimen und Respekt vor der Substanz. Was Ihre Familie geprägt hat, bleibt erhalten.',
    bild: bibliothek,
    alt: 'Restaurierte Einbaubibliothek aus Massivholz',
  },
  {
    nr: '03',
    titel: 'Innenausbau & Reparatur',
    text: 'Türen, Dielung, Fensterinstandsetzung und Balkonverglasung im Berliner Altbau. Präzise Reparaturen, die man am Ende nicht mehr sieht.',
    bild: loft,
    alt: 'Innenausbau mit Einbauküche unter einer Stahltreppe',
  },
];
---

<section class="section leistungen" id="leistungen-v3" aria-label="Leistungen">
  <div class="wrap">
    <div class="section-head">
      <span class="section-num" data-num="02" aria-hidden="true"></span>
      <p class="eyebrow reveal">Unsere Leistungen</p>
      <h2 class="headline split">Wie wir Ihnen helfen.</h2>
    </div>

    <ul class="lst__rows">
      {
        leistungen.map((l, i) => (
          <li class="lst__row reveal" style={`--reveal-delay: ${i * 0.08}s`}>
            <span class="lst__nr" aria-hidden="true">
              {l.nr}
            </span>
            <div class="lst__body">
              <h3 class="lst__titel">{l.titel}</h3>
              <p class="lst__text">{l.text}</p>
            </div>
            <div class="photo lst__thumb">
              <Image src={l.bild} alt={l.alt} widths={[320]} sizes="160px" quality={78} />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lst__rows {
    list-style: none;
    margin-top: clamp(3rem, 7vh, 5rem);
  }

  .lst__row {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 1.5rem 2rem;
    align-items: center;
    padding-block: clamp(1.75rem, 4vh, 2.75rem);
    border-top: 1px solid var(--oak-line);
    transition:
      opacity 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }

  .lst__rows .lst__row:last-child {
    border-bottom: 1px solid var(--oak-line);
  }

  /* Hover dimmt die nicht-gehoverten Zeilen auf 0.4 */
  @media (hover: hover) {
    .lst__rows:hover .lst__row:not(:hover) {
      opacity: 0.4;
    }
    .lst__row:hover {
      border-top-color: rgba(184, 137, 90, 0.55);
    }
    .lst__row:hover .lst__titel {
      transform: translateX(0.5rem);
    }
  }

  .lst__nr {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--oak);
    align-self: start;
    padding-top: 0.4rem;
  }

  .lst__titel {
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    transition: transform 0.5s var(--ease-out);
  }

  .lst__text {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .lst__thumb {
    width: 160px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .lst__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .lst__row {
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas:
        'nr body'
        'nr thumb';
      align-items: start;
      gap: 0.5rem 1.25rem;
    }
    .lst__nr {
      grid-area: nr;
    }
    .lst__body {
      grid-area: body;
    }
    .lst__thumb {
      grid-area: thumb;
      width: 100%;
      max-width: 12rem;
      margin-top: 1rem;
    }
  }
</style>
