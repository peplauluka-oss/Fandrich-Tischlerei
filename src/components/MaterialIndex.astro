---
// Schmales Zwischenband (Rhythmuswechsel) zwischen Werkstatt und Prozess.
// Eine Zeile Fraunces, --ink auf --paper. Sehr langsames Marquee; bei
// prefers-reduced-motion statisch und umbrechend. Nur verifizierte Begriffe.
const materialien = [
  'Eiche',
  'Esche',
  'Kirschbaum',
  'Lärche',
  'Schellack',
  'Zinken',
  'Schlitz und Zapfen',
  'Gratleisten',
];
---

<section class="matidx" aria-label="Materialien und Verbindungen">
  <div class="matidx__track" aria-hidden="true">
    {
      [0, 1].map((dup) => (
        <div class="matidx__row" data-dup={dup}>
          {materialien.map((m) => (
            <>
              <span class="matidx__word">{m}</span>
              <span class="matidx__dot">·</span>
            </>
          ))}
        </div>
      ))
    }
  </div>
  <p class="visually-hidden">
    Materialien und Verbindungen: {materialien.join(', ')}.
  </p>
</section>

<style>
  .matidx {
    /* nur oben eine Linie — die Border-Top der folgenden Prozess-Sektion
       schließt das Band unten ab (keine Doppellinie). */
    border-top: 1px solid var(--oak-line);
    padding-block: clamp(1.4rem, 3vh, 2.2rem);
    overflow: hidden;
  }

  .matidx__track {
    display: flex;
    width: max-content;
    animation: matidx-scroll 48s linear infinite;
  }

  .matidx__row {
    display: flex;
    align-items: center;
    flex: none;
    padding-right: 0; /* nahtloser Übergang, Trenner steht schon am Ende */
  }

  .matidx__word {
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-inline: clamp(0.9rem, 2vw, 1.6rem);
  }

  .matidx__dot {
    color: var(--oak);
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
  }

  @keyframes matidx-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* zwei identische Reihen → um genau eine Reihe verschieben = nahtlos */
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .matidx {
      overflow: visible;
    }
    .matidx__track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    /* Bei statischer Ansicht die zweite (Duplikat-)Reihe ausblenden */
    .matidx__row[data-dup='1'] {
      display: none;
    }
    .matidx__row {
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
