---
import { Image } from 'astro:assets';
import { galerieImages, mx } from '../data/images';

// 4 Projekte, jedes Bild genau 1× (loft 01, schrank 02, fassade 03, steg 04).
const [p1, p2, p3, p4] = galerieImages;
const zitat = 'Ein Möbel ist gut, wenn man nach zwanzig Jahren nichts daran ändern möchte.';
---

<section class="section arb4" id="arbeiten-v4" aria-label="Ausgewählte Arbeiten">
  <div class="wrap">
    <div class="arb4__head">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(03)</span>Ausgewählte Arbeiten</p>
      <h2 class="headline--v4 split">Vier Räume, ein Anspruch.</h2>
    </div>
  </div>

  <!-- Gruppe 1: P1 + P2, verbunden durch Zeitleisten-Hairline -->
  <div class="wrap arb4__group" data-rail>
    <span class="arb4__rail" aria-hidden="true"><span class="arb4__railfill" data-rail-fill></span></span>

    <div class="arb4__panel arb4__p1" data-clip>
      <figure class="arb4__fig" data-cursor="view">
        <div class="photo arb4__frame" data-plx style={`max-width:${mx(p1.src)}`}>
          <Image src={p1.src} alt={p1.alt} widths={[Math.round(p1.src.width / 2), p1.src.width]} sizes="(min-width:900px) 26rem, 82vw" quality={82} />
        </div>
      </figure>
      <figcaption class="arb4__cap arb4__cap--sticky wp-anno">
        <span class="wp-anno__mark" aria-hidden="true"></span>
        <span><span class="wp-anno__nr">Abb. {p1.nr}</span> — {p1.caption}</span>
      </figcaption>
    </div>

    <div class="arb4__panel arb4__p2" data-clip>
      <span class="arb4__bignr" aria-hidden="true">{p2.nr}</span>
      <figure class="arb4__fig" data-cursor="view">
        <div class="photo arb4__frame" style={`max-width:${mx(p2.src)}`}>
          <Image src={p2.src} alt={p2.alt} widths={[p2.src.width]} sizes="(min-width:900px) 17rem, 52vw" quality={80} />
        </div>
        <figcaption class="arb4__cap wp-anno">
          <span class="wp-anno__mark" aria-hidden="true"></span>
          <span><span class="wp-anno__nr">Abb. {p2.nr}</span> — {p2.caption}</span>
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- Zwischenspiel: Pull-Quote auf warmem Streifen -->
  <div class="arb4__quote section--warm">
    <blockquote class="arb4__quotetext reveal">{zitat}</blockquote>
  </div>

  <!-- Gruppe 2: P3 (überlappt Streifen) + P4 + CTA -->
  <div class="wrap arb4__group arb4__group--2" data-rail>
    <span class="arb4__rail" aria-hidden="true"><span class="arb4__railfill" data-rail-fill></span></span>

    <div class="arb4__panel arb4__p3" data-clip>
      <figure class="arb4__fig" data-cursor="view">
        <div class="photo arb4__frame" style={`max-width:${mx(p3.src)}`}>
          <Image src={p3.src} alt={p3.alt} widths={[p3.src.width]} sizes="(min-width:900px) 18rem, 56vw" quality={80} />
        </div>
        <figcaption class="arb4__cap wp-anno">
          <span class="wp-anno__mark" aria-hidden="true"></span>
          <span><span class="wp-anno__nr">Abb. {p3.nr}</span> — {p3.caption}</span>
        </figcaption>
      </figure>
    </div>

    <div class="arb4__panel arb4__p4" data-clip>
      <figure class="arb4__fig" data-cursor="view">
        <div class="photo arb4__frame" data-plx style={`max-width:${mx(p4.src)}`}>
          <Image src={p4.src} alt={p4.alt} widths={[Math.round(p4.src.width / 2), p4.src.width]} sizes="(min-width:900px) 33rem, 88vw" quality={82} />
        </div>
        <figcaption class="arb4__cap wp-anno">
          <span class="wp-anno__mark" aria-hidden="true"></span>
          <span><span class="wp-anno__nr">Abb. {p4.nr}</span> — {p4.caption}</span>
        </figcaption>
      </figure>
      <a href="#kontakt-v4" class="btn btn--oak arb4__cta" data-cursor="link">
        Projekt anfragen <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .arb4__group {
    position: relative;
    margin-top: clamp(3rem, 8vh, 6rem);
    padding-left: clamp(1.25rem, 4vw, 3rem);
  }
  .arb4__group--2 {
    margin-top: clamp(-2rem, -4vh, -3rem); /* P3 überlappt den Zitat-Streifen leicht */
    z-index: 1;
  }

  /* Zeitleisten-Hairline mit Stationspunkten — die Oak-Linie zeichnet
     sich mit dem Scrollfortschritt (führt durch die Arbeiten) */
  .arb4__rail {
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--oak-line);
  }
  .arb4__railfill {
    position: absolute;
    inset: 0;
    background: var(--oak);
    transform: scaleY(0);
    transform-origin: top;
    will-change: transform;
  }

  .arb4__panel {
    position: relative;
    padding-block: clamp(2rem, 5vh, 3.5rem);
  }
  /* Stationspunkt (Oak): poppt, sobald das Panel sichtbar wird */
  .arb4__panel::before {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(1.25rem, 4vw, 3rem) - 3px);
    top: clamp(2.5rem, 6vh, 4rem);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--oak);
    transform: scale(0);
    transition: transform 0.45s var(--ease-out) 0.2s;
  }
  .arb4__panel.is-in::before {
    transform: scale(1);
  }

  .arb4__fig {
    margin: 0;
  }
  .arb4__frame {
    overflow: hidden;
    width: 100%;
    background: var(--paper-dim);
  }
  .arb4__frame :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }
  /* Parallax-Bilder brauchen die Scale-Reserve dauerhaft */
  [data-plx] :global(img) {
    will-change: transform;
  }
  /* Hover-Zoom auf Nicht-Parallax-Bildern (Feedback: „hier ist ein Werk") */
  @media (hover: hover) {
    .arb4__fig:hover .arb4__frame:not([data-plx]) :global(img) {
      transform: scale(1.04);
    }
  }
  .arb4__cap {
    margin-top: 0.8rem;
  }

  /* P1: Bild links, Caption rechts sticky (Desktop) */
  .arb4__p1 {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }
  .arb4__cap--sticky {
    margin-top: 0;
  }
  @media (min-width: 900px) {
    .arb4__cap--sticky {
      position: sticky;
      top: 40vh;
    }
  }

  /* P2: klein rechts, Riesennummer halb hinter dem Bild */
  .arb4__p2 {
    display: flex;
    justify-content: flex-end;
  }
  .arb4__p2 .arb4__fig {
    position: relative;
    z-index: 1;
  }
  .arb4__bignr {
    position: absolute;
    right: clamp(6rem, 18vw, 16rem);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(7rem, 20vw, 16rem);
    line-height: 0.8;
    color: var(--oak);
    opacity: 0.16;
    z-index: 0;
    pointer-events: none;
  }

  /* Zitat-Streifen (warm, volle Breite) */
  .arb4__quote {
    margin-top: clamp(3rem, 7vh, 5rem);
    padding-block: clamp(4rem, 12vh, 8rem);
    padding-inline: var(--gutter);
  }
  .arb4__quotetext {
    position: relative;
    width: min(100% - 2 * var(--gutter), 26ch);
    margin-inline: auto;
    text-align: center;
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(1.9rem, 4.6vw, 3.6rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: var(--ink);
  }
  .arb4__quotetext::before {
    content: '\201C';
    position: absolute;
    top: -0.62em;
    left: 50%;
    transform: translateX(-50%);
    font-size: 2.4em;
    line-height: 1;
    color: var(--oak);
    opacity: 0.65;
  }

  /* P3: mittig */
  .arb4__p3 {
    display: flex;
    justify-content: center;
  }
  /* P4: normal, Abschluss + CTA */
  .arb4__p4 .arb4__cta {
    margin-top: 1.75rem;
  }

  /* Clip-Reveal */
  .arb4__panel[data-clip] .arb4__frame {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.85s var(--ease-out);
  }
  .arb4__panel[data-clip].is-in .arb4__frame {
    clip-path: inset(0 0 0 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .arb4__panel[data-clip] .arb4__frame {
      clip-path: none;
      transition: none;
    }
    .arb4__panel::before {
      transform: scale(1);
      transition: none;
    }
    .arb4__railfill {
      transform: none;
    }
  }

  @media (max-width: 899px) {
    .arb4__p1 {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .arb4__bignr {
      right: 2vw;
      font-size: clamp(5rem, 26vw, 9rem);
    }
    .arb4__group {
      padding-left: 1.5rem;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const figs = document.querySelectorAll<HTMLElement>('#arbeiten-v4 [data-clip]');
  if (reduced) {
    figs.forEach((f) => f.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    figs.forEach((f) => io.observe(f));
  }
</script>
