---
import ShowcaseGallery from './ShowcaseGallery';
---

<section class="section arb4" id="arbeiten-v4" aria-label="Ausgewählte Arbeiten">
  <div class="wrap">
    <div class="arb4__head">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(03)</span>Aus der Werkstatt</p>
      <h2 class="headline--v4 split">Vier Räume, ein Anspruch.</h2>
    </div>
  </div>

  <ShowcaseGallery client:visible />
</section>

<style>
  .arb4 {
    padding-bottom: var(--section-gap);
  }
  .arb4__head {
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
</style>
