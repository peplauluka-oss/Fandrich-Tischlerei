---
/**
 * CTA-Höhepunkt (Schritt 6). Der generische 4-Schritt-Prozess ist raus;
 * seine ehrliche Kurzinfo lebt als schlanke Prozess-Leiste weiter. Der
 * Call-to-Action dominiert: großes Walnuss-Band (echtes Holz), Headline,
 * Oak-Button + Telefon. Kein Ghost-Wasserzeichen (impeccable-Ban).
 */
import { site } from '../data/site';
import woodTex from '../assets/textures/holz-kiefer.jpeg';

const ablauf = [
  { nr: '01', t: 'Aufmaß & Beratung' },
  { nr: '02', t: 'Entwurf mit Material zum Anfassen' },
  { nr: '03', t: 'Fertigung in Pankow' },
  { nr: '04', t: 'Montage & Übergabe' },
];
---

<section class="cta" id="cta-band" aria-label="Projekt anfragen" style={`--panel-tex: url(${woodTex.src})`}>
  <div class="wrap cta__inner">
    <ol class="cta__ribbon" aria-label="So läuft es ab">
      {
        ablauf.map((a) => (
          <li class="cta__beat">
            <span class="cta__beatnr" aria-hidden="true">{a.nr}</span>
            <span class="cta__beatt">{a.t}</span>
          </li>
        ))
      }
    </ol>

    <div class="cta__main">
      <h2 class="cta__title split">Lassen Sie uns über Ihr Projekt sprechen.</h2>
      <p class="cta__sub">
        Vom ersten Aufmaß bis zur Montage — ein Ansprechpartner, kurze Wege, alles aus einer Hand.
      </p>

      <div class="cta__actions">
        <a href="#kontakt-v4" class="btn btn--oak cta__btn" data-cursor="link">
          Projekt anfragen <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href={`tel:${site.phoneHref}`} class="cta__tel" data-cursor="link">
          oder direkt anrufen <strong>{site.phone}</strong>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    color: var(--paper);
    padding-block: clamp(4rem, 10vh, 6.5rem);
    background-color: #201610;
    background-image:
      radial-gradient(120% 90% at 82% 10%, rgba(184, 137, 90, 0.22), transparent 55%),
      linear-gradient(150deg, rgba(16, 10, 6, 0.82), rgba(34, 23, 14, 0.9)),
      var(--panel-tex, none);
    background-size: cover, cover, cover;
    background-position: center;
  }

  /* Schlanke Prozess-Leiste (ersetzt die 4 Karten) */
  .cta__ribbon {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.5rem;
    padding-bottom: clamp(2rem, 5vh, 3rem);
    margin-bottom: clamp(2rem, 5vh, 3rem);
    border-bottom: 1px solid rgba(250, 247, 242, 0.14);
  }
  .cta__beat {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: rgba(250, 247, 242, 0.7);
  }
  .cta__beatnr {
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--oak);
  }

  .cta__main {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  .cta__title {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2.2rem, 5.2vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--paper);
    text-wrap: balance;
  }
  .cta__sub {
    display: none;
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    padding-bottom: 0.3rem;
  }
  .cta__btn {
    font-size: 1.05rem;
    padding: 1.15rem 2rem;
    transition:
      transform 0.16s ease-out,
      filter 0.2s ease-out;
  }
  .cta__btn:hover {
    filter: brightness(1.05);
  }
  .cta__btn:active {
    transform: scale(0.98);
  }
  .cta__tel {
    display: inline-flex;
    gap: 0.4rem;
    text-decoration: none;
    font-size: 0.98rem;
    color: rgba(250, 247, 242, 0.82);
  }
  .cta__tel strong {
    color: var(--paper);
    border-bottom: 1px solid rgba(184, 137, 90, 0.5);
    padding-bottom: 1px;
    transition: border-color 0.25s var(--ease-out);
  }
  .cta__tel:hover strong {
    border-color: var(--oak);
  }

  @media (max-width: 899px) {
    .cta__main {
      grid-template-columns: 1fr;
      gap: clamp(1.75rem, 5vh, 2.5rem);
      align-items: start;
    }
    /* Der erklärende Untertext hilft mobil, wo die Prozess-Leiste kürzer wirkt */
    .cta__sub {
      display: block;
      margin-top: 1rem;
      max-width: 46ch;
      color: rgba(250, 247, 242, 0.78);
      font-size: 1rem;
      line-height: 1.5;
    }
  }
</style>
