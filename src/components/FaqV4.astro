---
/**
 * Q&A (Schritt 5). Die früheren neutralen Balken werden zu Holzdielen:
 * jede Frage ein Brett mit echter Maserung, in vier Tönen gestapelt.
 * Kein Eyebrow / keine „(06)"-Nummer, kein Warm-Tint (impeccable-Bans).
 */
import FaqAccordion from './FaqAccordion';
import woodTex from '../assets/textures/holz-kiefer.jpeg';
---

<section class="section faq4" id="faq-v4" aria-label="Häufige Fragen">
  <div class="wrap faq4__inner">
    <div class="faq4__head">
      <h2 class="faq4__title split">Gute Frage.</h2>
      <p class="faq4__intro reveal">
        Das Wichtigste in Kürze — von der Fensterwartung bis zur Möbelreparatur. Ihre Frage ist nicht
        dabei? <a href="#kontakt-v4" class="link-line">Schreiben Sie uns.</a>
      </p>
    </div>

    <div class="faq4__list">
      <FaqAccordion client:visible texUrl={woodTex.src} />
    </div>
  </div>
</section>

<style>
  .faq4 {
    position: relative;
  }
  .faq4__inner {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .faq4__head {
    position: sticky;
    top: 6rem;
  }
  .faq4__title {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--wood-ink);
    text-wrap: balance;
  }
  .faq4__intro {
    margin-top: clamp(1.1rem, 3vh, 1.75rem);
    color: rgba(58, 42, 28, 0.8);
    max-width: 34ch;
  }

  @media (max-width: 899px) {
    .faq4__inner {
      grid-template-columns: 1fr;
      gap: clamp(1.75rem, 5vh, 2.5rem);
    }
    .faq4__head {
      position: static;
    }
  }
</style>
