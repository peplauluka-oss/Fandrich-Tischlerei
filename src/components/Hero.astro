---
import { Image } from 'astro:assets';
import { heroBild, maxDisplayWidth } from '../data/images';

// Bild ist Fenster, nicht Tapete: 21:9-Ausschnitt, cover — Qualität unkritisch.
const bildBreite = maxDisplayWidth(heroBild);
---

<section class="hero" id="top" aria-label="Intro">
  <div class="wrap hero__stage">
    <h1 class="hero__title">
      <span class="hero__line hero__line--1"><span class="hero__lineIn">Handwerk,</span></span>

      <span class="hero__midrow">
        <span class="hero__window" data-hero-window>
          <span class="hero__windowInner photo" data-hero-parallax>
            <Image
              src={heroBild.src}
              alt={heroBild.alt}
              widths={[Math.round(heroBild.src.width / 2), heroBild.src.width]}
              sizes={`(min-width: 1025px) 44vw, 92vw`}
              loading="eager"
              fetchpriority="high"
              quality={82}
            />
          </span>
        </span>
      </span>

      <span class="hero__line hero__line--2">
        <span class="hero__lineIn">das <span class="oak">bleibt.</span></span>
      </span>
    </h1>

    <div class="hero__foot">
      <p class="hero__sub">
        Möbel nach Maß, Restaurierung und Innenausbau — entworfen, gefertigt und montiert von
        unserer Werkstatt in Pankow.
      </p>
      <div class="hero__actions">
        <a href="#kontakt" class="btn">
          Projekt anfragen <span class="arrow" aria-hidden="true">→</span>
        </a>
        <span class="hero__meta">Berlin-Pankow — Meisterbetrieb</span>
      </div>
    </div>
  </div>

  <div class="hero__scrollhint" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(7rem, 16vh, 10rem) clamp(4rem, 9vh, 6rem);
    overflow: clip;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(3.5rem, 11vw, 9rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-block: 0.03em;
    will-change: transform;
  }

  .hero__line--2 {
    padding-left: 12vw;
  }

  .hero__lineIn {
    display: block;
    transform: translateY(110%);
  }

  .oak {
    color: var(--oak);
  }

  /* Bild-Fenster zwischen den Zeilen, rechtsbündig */
  .hero__midrow {
    display: flex;
    justify-content: flex-end;
    margin-block: -0.12em;
    position: relative;
    z-index: 2;
  }

  .hero__window {
    display: block;
    width: min(44vw, 40rem);
    aspect-ratio: 21 / 9;
    overflow: hidden;
    clip-path: inset(0 100% 0 0);
  }

  .hero__windowInner {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__windowInner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.15);
    will-change: transform;
  }

  .hero__foot {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: clamp(2.5rem, 6vh, 4rem);
    max-width: 46rem;
  }

  .hero__sub {
    font-size: 1.1rem;
    color: var(--ink-soft);
    max-width: 42ch;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero__meta {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .hero__scrollhint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 1px;
    height: 40px;
    background: var(--ink);
    opacity: 0.5;
    transform-origin: top;
    animation: hint-pulse 2.6s ease-in-out infinite;
  }

  @keyframes hint-pulse {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.25;
    }
    50% {
      transform: scaleY(1);
      opacity: 0.5;
    }
  }

  /* -------- Load-Choreografie: startet nach dem Preloader-Vorhang -------- */
  :global(html.intro-done) .hero__lineIn {
    animation: hero-line 0.95s var(--ease-out) both;
  }
  :global(html.intro-done) .hero__line--1 .hero__lineIn {
    animation-delay: 0.15s;
  }
  :global(html.intro-done) .hero__line--2 .hero__lineIn {
    animation-delay: 0.28s;
  }

  @keyframes hero-line {
    from {
      transform: translateY(110%);
    }
    to {
      transform: translateY(0);
    }
  }

  :global(html.intro-done) .hero__window {
    animation: hero-window 1.1s var(--ease-out) 0.5s both;
  }

  @keyframes hero-window {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 1024px) {
    .hero__midrow {
      justify-content: flex-start;
      margin-block: 0.4rem 0.6rem;
    }
    .hero__window {
      width: 92%;
      aspect-ratio: 16 / 9;
    }
    .hero__line--2 {
      padding-left: 6vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__lineIn {
      transform: none;
    }
    .hero__window {
      clip-path: inset(0 0 0 0);
    }
    .hero__windowInner :global(img) {
      transform: none;
    }
    .hero__scrollhint {
      animation: none;
    }
  }
</style>

<script>
  // Scroll: Zeilen driften auseinander (±30px), Bild fährt von scale(1.15) → 1.0.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const hero = document.querySelector<HTMLElement>('.hero');
    const l1 = document.querySelector<HTMLElement>('.hero__line--1');
    const l2 = document.querySelector<HTMLElement>('.hero__line--2');
    const img = document.querySelector<HTMLElement>('[data-hero-parallax] img');
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!hero) return;
      const rect = hero.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 oben im Viewport → 1 wenn Hero herausgescrollt
      const p = Math.min(Math.max(-rect.top / vh, 0), 1);
      if (l1) l1.style.transform = `translateY(${-30 * p}px)`;
      if (l2) l2.style.transform = `translateY(${30 * p}px)`;
      if (img) img.style.transform = `scale(${1.15 - 0.15 * Math.min(p * 2, 1)})`;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }
</script>
