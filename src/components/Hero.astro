---
import { Image } from 'astro:assets';
import { heroBild, maxDisplayWidth } from '../data/images';

// Typografischer Hero: kein Vollbild — das vorhandene Material trägt keine
// 100svh-Skalierung. Das Bild steht eingerückt und wird nie über seine
// native Auflösung hinaus dargestellt.
const bildBreite = maxDisplayWidth(heroBild);
---

<section class="hero" id="top" aria-label="Intro">
  <div class="hero__inner wrap">
    <div class="hero__text">
      <p class="eyebrow hero__line hero__line--1">
        Tischlerei &amp; Möbelrestaurierung — Berlin Pankow
      </p>
      <h1 class="hero__line hero__line--2">Handwerk, das bleibt.</h1>
      <p class="hero__sub hero__line hero__line--3">
        Möbel nach Maß, Restaurierung und Innenausbau — entworfen, gefertigt und montiert von
        unserer Werkstatt in Pankow.
      </p>
      <div class="hero__line hero__line--4">
        <a href="#kontakt" class="btn btn--paper"
          >Projekt anfragen <span class="arrow" aria-hidden="true">→</span></a
        >
      </div>
    </div>

    <figure class="hero__figure" style={`max-width: ${bildBreite}px`}>
      <div class="hero__frame photo">
        <Image
          src={heroBild.src}
          alt={heroBild.alt}
          widths={[Math.round(heroBild.src.width / 2), heroBild.src.width]}
          sizes={`(min-width: 900px) ${bildBreite}px, 88vw`}
          loading="eager"
          fetchpriority="high"
          quality={82}
        />
      </div>
      <figcaption>{heroBild.caption}</figcaption>
    </figure>
  </div>

  <div class="hero__scrollhint" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    align-items: center;
    overflow: clip;
    padding-block: clamp(7rem, 16vh, 10rem) clamp(5rem, 10vh, 7rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: end;
  }

  .hero__text .eyebrow {
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    max-width: 12ch;
  }

  .hero__sub {
    margin-top: 1.75rem;
    max-width: 44ch;
    color: rgba(250, 247, 242, 0.85);
  }

  .hero__line--4 {
    margin-top: 2.5rem;
  }

  /* Bild: eingerückt, nie über native Auflösung skaliert */
  .hero__figure {
    margin: 0;
    justify-self: end;
    width: 100%;
  }

  .hero__frame {
    overflow: clip;
  }

  .hero__frame :global(img) {
    width: 100%;
    height: auto;
  }

  .hero__figure figcaption {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.6);
  }

  .hero__figure figcaption::before {
    content: '';
    flex: none;
    width: 2.5rem;
    height: 1px;
    background: var(--oak);
  }

  /* Clip-Path-Reveal der Zeilen von unten, Stagger 120ms, Delay 0.3s */
  .hero__line {
    clip-path: inset(0 0 100% 0);
    transform: translateY(20px);
    animation: hero-line 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero__line--1 {
    animation-delay: 0.3s;
  }
  .hero__line--2 {
    animation-delay: 0.42s;
  }
  .hero__line--3 {
    animation-delay: 0.54s;
  }
  .hero__line--4 {
    animation-delay: 0.66s;
  }

  @keyframes hero-line {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(20px);
    }
    to {
      clip-path: inset(0 0 -20% 0);
      transform: translateY(0);
    }
  }

  .hero__figure {
    clip-path: inset(12% 0 12% 0);
    opacity: 0;
    animation: hero-figure 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.75s both;
  }

  @keyframes hero-figure {
    from {
      clip-path: inset(12% 0 12% 0);
      opacity: 0;
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  /* Scroll-Hinweis: 1px-Linie, pulsiert langsam */
  .hero__scrollhint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 1px;
    height: 40px;
    background: var(--paper);
    opacity: 0.7;
    animation: hint-pulse 2.6s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes hint-pulse {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.35;
    }
    50% {
      transform: scaleY(1);
      opacity: 0.7;
    }
  }

  @media (max-width: 899px) {
    .hero__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero__figure {
      justify-self: start;
      margin-left: clamp(1.5rem, 10vw, 4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line,
    .hero__figure,
    .hero__scrollhint {
      animation: none;
    }

    .hero__line,
    .hero__figure {
      clip-path: none;
      transform: none;
      opacity: 1;
    }
  }
</style>
