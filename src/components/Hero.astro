---
import { Image } from 'astro:assets';
import { heroBild } from '../data/images';
---

<section class="hero" id="top" aria-label="Intro">
  <div class="hero__media photo">
    <Image
      src={heroBild.src}
      alt={heroBild.alt}
      widths={[480, 800]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={82}
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content wrap">
    <p class="eyebrow hero__line hero__line--1">
      Tischlerei &amp; Möbelrestaurierung — Berlin Pankow
    </p>
    <h1 class="hero__line hero__line--2">Handwerk, das bleibt.</h1>
    <p class="hero__sub hero__line hero__line--3">
      Möbel nach Maß, Restaurierung und Innenausbau — gefertigt in unserer Werkstatt in Pankow,
      seit 1964.
    </p>
    <div class="hero__line hero__line--4">
      <a href="#kontakt" class="btn">Projekt anfragen <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="hero__scrollhint" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    color: var(--paper);
    display: flex;
    align-items: flex-end;
  }

  /* Bild gespiegelt: die ruhige Bildzone (Steg/Wasser) liegt so links unter
     dem Text, die Sonnen-Flare rechts. */
  .hero__media {
    position: absolute;
    inset: 0;
    transform: scaleX(-1);
    will-change: transform;
  }

  /* Zoom auf dem img, Parallax auf dem Wrapper — keine Transform-Konflikte */
  .hero__media :global(img) {
    width: 100%;
    height: calc(100% + 60px);
    object-fit: cover;
    object-position: center 40%;
    animation: hero-zoom 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  /* Verlauf unten für den Text-Overlay, dezenter Scrim oben für die Navigation */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(43, 37, 35, 0.45) 0%, rgba(43, 37, 35, 0) 22%),
      linear-gradient(to top, rgba(43, 37, 35, 0.55) 0%, rgba(43, 37, 35, 0) 55%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(4rem, 10vh, 7rem);
  }

  .hero__content .eyebrow {
    color: var(--paper);
    opacity: 0.85;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    max-width: 12ch;
  }

  .hero__sub {
    margin-top: 1.5rem;
    max-width: 44ch;
    font-size: 1.1rem;
    opacity: 0.92;
  }

  .hero__line--4 {
    margin-top: 2.25rem;
  }

  /* Clip-Path-Reveal der Textzeilen von unten, Stagger 120ms, Delay 0.3s */
  .hero__line {
    clip-path: inset(0 0 100% 0);
    transform: translateY(20px);
    animation: hero-line 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero__line--1 {
    animation-delay: 0.3s;
  }
  .hero__line--2 {
    animation-delay: 0.42s;
  }
  .hero__line--3 {
    animation-delay: 0.54s;
  }
  .hero__line--4 {
    animation-delay: 0.66s;
  }

  @keyframes hero-line {
    from {
      clip-path: inset(0 0 100% 0);
      transform: translateY(20px);
    }
    to {
      clip-path: inset(0 0 -20% 0);
      transform: translateY(0);
    }
  }

  /* Scroll-Hinweis: 1px-Linie, pulsiert langsam */
  .hero__scrollhint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 1px;
    height: 40px;
    background: var(--paper);
    opacity: 0.7;
    animation: hint-pulse 2.6s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes hint-pulse {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.35;
    }
    50% {
      transform: scaleY(1);
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img),
    .hero__line,
    .hero__scrollhint {
      animation: none;
    }

    .hero__line {
      clip-path: none;
      transform: none;
    }
  }
</style>

<script>
  // Scroll-Parallax: Bild bewegt sich mit Faktor 0.85 (max ~60px), transform only.
  const media = document.querySelector<HTMLElement>('.hero__media');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (media && !reduced) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = Math.min(window.scrollY * 0.15, 60);
      media.style.transform = `scaleX(-1) translateY(${y}px)`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
