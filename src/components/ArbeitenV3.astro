---
import { Image } from 'astro:assets';
import kueche from '../assets/images/IMG_2479.jpeg';
import bibliothek from '../assets/images/IMG_2480.jpeg';
import fensterbank from '../assets/images/IMG_2470.jpeg';
import steg from '../assets/images/IMG_2486.jpeg';
import schrank from '../assets/images/IMG_2463.jpeg';
import fassade from '../assets/images/IMG_2467.jpeg';
import loft from '../assets/images/IMG_2475.jpeg';

// Es gibt KEIN GROSS-Bild (STATUS.md). Statt hochskalierter Full-Bleed-Panels:
// editoriale Feature-Zeilen bei max. nativer Breite ÷ 1.5, dichte Bildpaare,
// dunkles Typo-Panel. TODO: Originale ≥1600px → echte Vollbreite-Panels.
const mx = (w: number) => `${Math.round(w / 1.5)}px`;

const zitat = 'Ein Möbel ist gut, wenn man nach zwanzig Jahren nichts daran ändern möchte.';
---

<section class="section arb" id="arbeiten-v3" aria-label="Ausgewählte Arbeiten">
  <div class="wrap">
    <div class="section-head">
      <span class="section-num" data-num="03" aria-hidden="true"></span>
      <p class="eyebrow reveal">Ausgewählte Arbeiten</p>
      <h2 class="headline split">Aus der Werkstatt.</h2>
    </div>
  </div>

  <!-- A — Feature (Bild links) -->
  <div class="wrap arb__feature">
    <figure class="arb__fig" data-clip>
      <div class="photo arb__frame" data-parallax style={`max-width:${mx(kueche.width)}`}>
        <Image
          src={kueche}
          alt="Helle Einbauküche mit freistehender Kochinsel und Gartenblick"
          widths={[Math.round(kueche.width / 2), kueche.width]}
          sizes="(min-width: 900px) 27rem, 88vw"
          quality={82}
        />
      </div>
    </figure>
    <div class="arb__meta">
      <span class="arb__idx" aria-hidden="true">01</span>
      <p class="arb__cap">Einbauküche mit Kochinsel, Lack matt — Weißensee</p>
    </div>
  </div>

  <!-- B — Versetztes Paar -->
  <div class="wrap arb__pair">
    <figure class="arb__fig arb__pairfig" data-clip style="--d: 0s">
      <div class="photo arb__frame" style={`max-width:${mx(bibliothek.width)}`}>
        <Image src={bibliothek} alt="Raumhohe Einbaubibliothek aus Kirschbaumholz" widths={[bibliothek.width]} sizes="(min-width: 900px) 19rem, 44vw" quality={80} />
      </div>
      <figcaption>Einbaubibliothek, Kirschbaum — Prenzlauer Berg</figcaption>
    </figure>
    <figure class="arb__fig arb__pairfig arb__pairfig--low" data-clip style="--d: 0.12s">
      <div class="photo arb__frame" style={`max-width:${mx(fensterbank.width)}`}>
        <Image src={fensterbank} alt="Loft mit durchlaufender Fensterbank und Regalen" widths={[fensterbank.width]} sizes="(min-width: 900px) 19rem, 44vw" quality={80} />
      </div>
      <figcaption>Fensterbank mit Stauraum, seidenmatt — Pankow</figcaption>
    </figure>
  </div>

  <!-- C — Feature (Bild rechts, breitestes Motiv) -->
  <div class="wrap arb__feature arb__feature--right">
    <div class="arb__meta">
      <span class="arb__idx" aria-hidden="true">02</span>
      <p class="arb__cap">Seesteg, Lärche geriffelt — Außenprojekt Brandenburg</p>
    </div>
    <figure class="arb__fig" data-clip>
      <div class="photo arb__frame" data-parallax style={`max-width:${mx(steg.width)}`}>
        <Image
          src={steg}
          alt="Holzsteg aus Lärchendielen führt in einen ruhigen See, Abendlicht"
          widths={[Math.round(steg.width / 2), steg.width]}
          sizes="(min-width: 900px) 33rem, 88vw"
          quality={82}
        />
      </div>
    </figure>
  </div>

  <!-- D — Typo-Panel (dunkel) -->
  <div class="arb__typo on-ink">
    <blockquote class="arb__quote split">{zitat}</blockquote>
  </div>

  <!-- E — Versetztes Paar -->
  <div class="wrap arb__pair">
    <figure class="arb__fig arb__pairfig" data-clip style="--d: 0s">
      <div class="photo arb__frame" style={`max-width:${mx(schrank.width)}`}>
        <Image src={schrank} alt="Begehbarer Einbauschrank unter einer Dachschräge" widths={[schrank.width]} sizes="(min-width: 900px) 19rem, 44vw" quality={80} />
      </div>
      <figcaption>Schrank in der Dachschräge, MDF lackiert — Prenzlauer Berg</figcaption>
    </figure>
    <figure class="arb__fig arb__pairfig arb__pairfig--low" data-clip style="--d: 0.12s">
      <div class="photo arb__frame" style={`max-width:${mx(fassade.width)}`}>
        <Image src={fassade} alt="Holzfassade aus Lärchenleisten mit Terrassendeck" widths={[fassade.width]} sizes="(min-width: 900px) 19rem, 44vw" quality={80} />
      </div>
      <figcaption>Fassade & Terrasse, Lärche — Barnim</figcaption>
    </figure>
  </div>

  <!-- F — Feature + CTA -->
  <div class="wrap arb__feature">
    <figure class="arb__fig" data-clip>
      <div class="photo arb__frame" data-parallax style={`max-width:${mx(loft.width)}`}>
        <Image
          src={loft}
          alt="Offenes Loft mit weißer Einbauküche unter einer Stahltreppe"
          widths={[Math.round(loft.width / 2), loft.width]}
          sizes="(min-width: 900px) 27rem, 88vw"
          quality={82}
        />
      </div>
    </figure>
    <div class="arb__meta arb__meta--cta">
      <span class="arb__idx" aria-hidden="true">03</span>
      <p class="arb__cap">Küchenzeile & Galerie, Lack und Stahl — Mitte</p>
      <a href="#kontakt-v3" class="btn btn--oak" data-cursor="link">
        Projekt anfragen <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .arb__feature,
  .arb__pair {
    margin-top: clamp(4rem, 9vh, 7rem);
  }

  /* Feature-Zeile: Bild + große Meta füllen die Breite (Dichte statt Weißraum) */
  .arb__feature {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .arb__feature--right {
    grid-template-columns: 1fr auto;
  }

  .arb__fig {
    margin: 0;
  }

  .arb__frame {
    overflow: hidden;
    width: 100%;
  }

  .arb__frame :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Interner Parallax auf Feature-Bildern */
  [data-parallax] {
    position: relative;
  }
  [data-parallax] :global(img) {
    will-change: transform;
  }

  .arb__meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .arb__feature--right .arb__meta {
    text-align: right;
    align-items: flex-end;
  }

  .arb__idx {
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1;
    color: var(--oak);
    opacity: 0.5;
  }

  .arb__cap {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    max-width: 30ch;
  }

  .arb__cap::before {
    content: '';
    flex: none;
    width: 24px;
    height: 1px;
    background: var(--oak);
  }

  .arb__meta--cta .btn {
    margin-top: 0.75rem;
  }

  /* Versetztes Paar */
  .arb__pair {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: flex-start;
  }

  .arb__pairfig {
    width: 100%;
  }

  .arb__pairfig--low {
    margin-top: 64px;
  }

  .arb__pairfig figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.9rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .arb__pairfig figcaption::before {
    content: '';
    flex: none;
    width: 24px;
    height: 1px;
    background: var(--oak);
  }

  /* Typo-Panel dunkel, volle Breite */
  .arb__typo {
    margin-top: clamp(4rem, 9vh, 7rem);
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(4rem, 12vh, 8rem);
    padding-inline: var(--gutter);
  }

  .arb__quote {
    width: min(100% - 2 * var(--gutter), 40rem);
    margin-inline: auto;
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(1.7rem, 3.6vw, 2.8rem);
    letter-spacing: -0.02em;
    line-height: 1.32;
    text-align: center;
    text-wrap: balance;
  }

  /* Clip-Reveal (Clip auf innerem Rahmen — IO beobachtet die unbeschnittene Figur) */
  .arb__fig[data-clip] .arb__frame {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.85s var(--ease-out);
    transition-delay: var(--d, 0s);
  }
  .arb__fig[data-clip].is-in .arb__frame {
    clip-path: inset(0 0 0 0);
  }
  .arb__fig[data-clip] figcaption {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
    transition-delay: calc(var(--d, 0s) + 0.15s);
  }
  .arb__fig[data-clip].is-in figcaption {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .arb__fig[data-clip] .arb__frame {
      clip-path: none;
      transition: none;
    }
    .arb__fig[data-clip] figcaption {
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    .arb__feature,
    .arb__feature--right {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .arb__feature--right {
      grid-template-areas: none;
    }
    /* Meta auf Mobil immer unter dem Bild, linksbündig */
    .arb__feature--right .arb__meta {
      order: 2;
      text-align: left;
      align-items: flex-start;
    }
    .arb__frame {
      max-width: 100% !important;
    }
    .arb__pair {
      gap: 1rem;
    }
    .arb__pairfig--low {
      margin-top: 40px;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Clip-Reveal via eigenem Observer (Clip liegt auf innerem Rahmen)
  const figs = document.querySelectorAll<HTMLElement>('#arbeiten-v3 [data-clip]');
  if (reduced) {
    figs.forEach((f) => f.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    figs.forEach((f) => io.observe(f));
  }

  // Interner Parallax ±6 % auf Feature-Bildern (transform only)
  if (!reduced) {
    const items = [...document.querySelectorAll<HTMLElement>('#arbeiten-v3 [data-parallax] img')];
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      for (const img of items) {
        const frame = img.parentElement as HTMLElement;
        const rect = frame.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > vh) continue;
        const p = (rect.top + rect.height / 2 - vh / 2) / vh; // -0.5..0.5
        img.style.transform = `translateY(${(-p * 6).toFixed(2)}%) scale(1.13)`;
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
