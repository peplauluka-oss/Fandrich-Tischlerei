---
import { Image } from 'astro:assets';
import { galerieImages, mx } from '../data/images';

// Genau 4 Projekte (zentrale Zuordnung, jedes Foto genau 1×). Kein Grid, keine
// zwei gleichen Panel-Layouts hintereinander. Es gibt KEIN GROSS-Bild
// (STATUS.md) → „Full-Bleed" heißt hier: zentriert bei max. nativer Breite ÷ 1.5,
// niemals hochskaliert. Reihenfolge: 01 loft · 02 schrank · [Zitat] · 03 fassade · 04 steg.
const [p1, p2, p3, p4] = galerieImages;
const zitat = 'Ein Möbel ist gut, wenn man nach zwanzig Jahren nichts daran ändern möchte.';
---

<section class="section arb" id="arbeiten-v3" aria-label="Ausgewählte Arbeiten">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(03)</span>Aus der Werkstatt</p>
      <h2 class="headline split">Vier Räume, ein Anspruch.</h2>
    </div>
  </div>

  <!-- Panel 01 — zentriert, Caption über dem Bild (Scrim), Clip von unten -->
  <div class="wrap arb__p1">
    <figure class="arb__fig arb__overlay" data-clip>
      <div class="photo arb__frame" data-parallax style={`max-width:${mx(p1.src)}`}>
        <Image
          src={p1.src}
          alt={p1.alt}
          widths={[Math.round(p1.src.width / 2), p1.src.width]}
          sizes="(min-width: 900px) 27rem, 90vw"
          quality={82}
        />
        <figcaption class="arb__cap arb__cap--on">
          <span class="arb__nr">{p1.nr}</span>
          <span class="arb__captext">{p1.caption}</span>
        </figcaption>
      </div>
    </figure>
  </div>

  <!-- Panel 02 — Bild rechts, Caption links (Desktop sticky) -->
  <div class="wrap arb__p2">
    <div class="arb__side">
      <div class="arb__sidecap">
        <span class="arb__nr">{p2.nr}</span>
        <p class="arb__captext">{p2.caption}</p>
      </div>
    </div>
    <figure class="arb__fig arb__fig--right" data-clip>
      <div class="photo arb__frame" style={`max-width:${mx(p2.src)}`}>
        <Image
          src={p2.src}
          alt={p2.alt}
          widths={[p2.src.width]}
          sizes="(min-width: 900px) 19rem, 60vw"
          quality={80}
        />
      </div>
    </figure>
  </div>

  <!-- Zwischenspiel — Pull-Quote auf --paper -->
  <div class="wrap arb__quote">
    <blockquote class="arb__quotetext split">{zitat}</blockquote>
  </div>

  <!-- Panel 03 — Bild links, nach oben versetzt (überlappt das Zitat leicht) -->
  <div class="wrap arb__p3">
    <figure class="arb__fig arb__fig--left" data-clip>
      <div class="photo arb__frame" style={`max-width:${mx(p3.src)}`}>
        <Image
          src={p3.src}
          alt={p3.alt}
          widths={[p3.src.width]}
          sizes="(min-width: 900px) 19rem, 55vw"
          quality={80}
        />
      </div>
    </figure>
    <div class="arb__side arb__side--right">
      <div class="arb__sidecap">
        <span class="arb__nr">{p3.nr}</span>
        <p class="arb__captext">{p3.caption}</p>
      </div>
    </div>
  </div>

  <!-- Panel 04 — normal breit, sachlicher Abschluss + CTA -->
  <div class="wrap arb__p4">
    <figure class="arb__fig" data-clip>
      <div class="photo arb__frame" data-parallax style={`max-width:${mx(p4.src)}`}>
        <Image
          src={p4.src}
          alt={p4.alt}
          widths={[Math.round(p4.src.width / 2), p4.src.width]}
          sizes="(min-width: 900px) 33rem, 90vw"
          quality={82}
        />
      </div>
      <figcaption class="arb__cap">
        <span class="arb__nr">{p4.nr}</span>
        <span class="arb__captext">{p4.caption}</span>
      </figcaption>
    </figure>
    <a href="#kontakt-v3" class="btn btn--oak arb__cta" data-cursor="link">
      Projekt anfragen <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .arb__p1,
  .arb__p2,
  .arb__p4 {
    margin-top: clamp(4rem, 9vh, 7rem);
  }

  .arb__fig {
    margin: 0;
  }

  .arb__frame {
    overflow: hidden;
    width: 100%;
  }

  .arb__frame :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  [data-parallax] :global(img) {
    will-change: transform;
  }

  /* Einheitliche Caption: Oak-Laufnummer + Text (Versalien, nicht kursiv) */
  .arb__cap,
  .arb__sidecap {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .arb__nr {
    flex: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    color: var(--oak);
  }

  .arb__captext {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    max-width: 34ch;
  }

  /* Panel 01 — zentriertes Bild, Caption über dem Bild mit Scrim */
  .arb__p1 {
    display: flex;
    justify-content: center;
  }
  .arb__overlay .arb__frame {
    position: relative;
  }
  .arb__cap--on {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding: 2.5rem 1.25rem 1.1rem;
    background: linear-gradient(to top, rgba(43, 37, 35, 0.72) 0%, rgba(43, 37, 35, 0) 100%);
  }
  .arb__cap--on .arb__nr {
    color: var(--oak);
  }
  .arb__cap--on .arb__captext {
    color: rgba(250, 247, 242, 0.92);
  }

  /* Panel 02 — Bild rechts, Caption-Spalte links (sticky auf Desktop) */
  .arb__p2 {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }
  .arb__fig--right {
    justify-self: end;
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }
  .arb__side {
    padding-top: clamp(1rem, 6vh, 4rem);
  }
  .arb__sidecap {
    flex-direction: column;
    gap: 0.75rem;
  }
  .arb__sidecap .arb__captext {
    letter-spacing: 0.16em;
  }
  @media (min-width: 900px) {
    .arb__side {
      position: sticky;
      top: 30vh;
    }
  }

  /* Zwischenspiel — Pull-Quote auf --paper */
  .arb__quote {
    margin-top: clamp(4rem, 10vh, 8rem);
    position: relative;
    z-index: 1;
  }
  .arb__quotetext {
    position: relative;
    z-index: 2;
    max-width: 24ch;
    margin-inline: auto;
    text-align: center;
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(1.9rem, 4.4vw, 3.4rem);
    line-height: 1.24;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .arb__quotetext::before {
    content: '\201C';
    position: absolute;
    top: -0.55em;
    left: 50%;
    transform: translateX(-50%);
    font-size: 2.4em;
    line-height: 1;
    color: var(--oak);
    opacity: 0.6;
  }

  /* Panel 03 — Bild links, nach oben versetzt (überlappt Zitat leicht) */
  .arb__p3 {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
    margin-top: clamp(-2rem, -4vh, -3rem);
  }
  .arb__fig--left {
    width: 100%;
  }
  .arb__side--right {
    text-align: left;
  }

  /* Panel 04 — normal, Abschluss + CTA */
  .arb__p4 .arb__cap {
    margin-top: 1rem;
  }
  .arb__cta {
    margin-top: 1.75rem;
  }

  /* Clip-Reveal (Clip auf innerem Rahmen; IO beobachtet die unbeschnittene Figur) */
  .arb__fig[data-clip] .arb__frame {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.85s var(--ease-out);
  }
  .arb__fig[data-clip].is-in .arb__frame {
    clip-path: inset(0 0 0 0);
  }
  /* Caption-Spalten starten verdeckt; das Skript blendet sie beim Eintritt ein. */
  .arb__sidecap {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .arb__fig[data-clip] .arb__frame {
      clip-path: none;
      transition: none;
    }
    .arb__sidecap {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 899px) {
    .arb__p2,
    .arb__p3 {
      grid-template-columns: 1fr;
      margin-top: clamp(3rem, 8vh, 5rem);
      gap: 1.25rem;
    }
    .arb__fig--right {
      justify-content: flex-start;
    }
    /* Panel 02: Caption unter dem Bild */
    .arb__p2 .arb__side {
      order: 2;
      position: static;
      padding-top: 0;
    }
    /* Panel 03: Bild zuerst, Caption darunter */
    .arb__side--right {
      order: 2;
    }
    .arb__sidecap {
      flex-direction: row;
      align-items: baseline;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Clip-Reveal + Caption-Einblendung via eigenem Observer
  const figs = document.querySelectorAll<HTMLElement>('#arbeiten-v3 [data-clip]');
  const sidecaps = document.querySelectorAll<HTMLElement>('#arbeiten-v3 .arb__sidecap');
  if (reduced) {
    figs.forEach((f) => f.classList.add('is-in'));
    sidecaps.forEach((c) => (c.style.opacity = '1'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    figs.forEach((f) => io.observe(f));

    // Caption-Spalten separat einblenden (unabhängig von der Figur-Position)
    const capIo = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).style.opacity = '1';
            (e.target as HTMLElement).style.transform = 'none';
            capIo.unobserve(e.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    sidecaps.forEach((c) => capIo.observe(c));
  }

  // Interner Parallax ±6 % auf den Landscape-Feature-Bildern (transform only)
  if (!reduced) {
    const items = [...document.querySelectorAll<HTMLElement>('#arbeiten-v3 [data-parallax] img')];
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      for (const img of items) {
        const frame = img.parentElement as HTMLElement;
        const rect = frame.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > vh) continue;
        const p = (rect.top + rect.height / 2 - vh / 2) / vh; // -0.5..0.5
        img.style.transform = `translateY(${(-p * 6).toFixed(2)}%) scale(1.13)`;
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
