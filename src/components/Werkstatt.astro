---
import { Image } from 'astro:assets';
import { maxDisplayWidth } from '../data/images';
import { werkstattVideos, werkstattPoster, werkstattAlt, werkstattCaption } from '../data/werkstattMedia';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasVideo = werkstattVideos.length > 0;

// Fakten — ausschließlich Verifiziertes, keine Jahreszahl, keine „0+"-Statistik.
const fakten = ['Meisterbetrieb', 'Eigene Werkstatt in Pankow', 'Treseburger Straße 30'];
---

<section class="section werkstatt on-ink" id="werkstatt-v3" aria-label="Werkstatt und Material">
  <div class="wrap werkstatt__grid">
    <div class="werkstatt__col">
      <div class="section-head">
        <p class="eyebrow reveal"><span class="eyebrow__idx">(04)</span>Werkstatt</p>
        <h2 class="headline split">Material, das man ernst nimmt.</h2>
      </div>
      <div class="werkstatt__text reveal">
        <p>
          Wir arbeiten mit Massivholz, das wir selbst aussuchen — Eiche, Esche, Kirschbaum — und
          mit Furnieren, deren Bild wir am Werkstück abstimmen. Verbindungen schneiden wir, wo es
          das Möbel verlangt, von Hand: Zinken, Schlitz und Zapfen, Gratleisten.
        </p>
        <p>
          Das dauert länger als ein Beschlag aus dem Katalog. Aber es hält länger — und man sieht
          es jeden Tag.
        </p>
      </div>

      <ul class="werkstatt__fakten reveal" style="--reveal-delay: 0.1s">
        {fakten.map((f) => <li>{f}</li>)}
      </ul>
    </div>

    <figure class="werkstatt__figure">
      <div class="photo werkstatt__frame" style={`max-width: ${maxDisplayWidth(werkstattPoster)}px`}>
        {
          hasVideo ? (
            <video
              class="werkstatt__video"
              autoplay
              muted
              loop={werkstattVideos.length === 1}
              playsinline
              preload="none"
              poster={werkstattPoster.src}
            >
              {werkstattVideos.map((v) => (
                <Fragment>
                  {v.webm && <source src={`${base}/${v.webm}`} type="video/webm" />}
                  {v.mp4 && <source src={`${base}/${v.mp4}`} type="video/mp4" />}
                </Fragment>
              ))}
            </video>
          ) : (
            <Image
              src={werkstattPoster}
              alt={werkstattAlt}
              widths={[480, werkstattPoster.width]}
              sizes="(min-width: 900px) 52vw, 92vw"
              quality={80}
            />
          )
        }
      </div>
      <figcaption>{werkstattCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  /* Dunkler Full-Bleed-Break: Sektion volle Breite, extra Luft (+40px) */
  .werkstatt {
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    padding-block: calc(var(--section-gap) + 2.5rem);
  }

  .werkstatt .eyebrow {
    color: var(--oak);
  }

  .werkstatt__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .werkstatt__text {
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }

  .werkstatt__text p {
    color: rgba(250, 247, 242, 0.82);
    max-width: 46ch;
  }

  .werkstatt__text p + p {
    margin-top: 1.25rem;
  }

  /* Faktenzeile — nur Verifiziertes, Oak-Trenner */
  .werkstatt__fakten {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.1rem;
    margin-top: clamp(2rem, 5vh, 3rem);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.7);
  }

  .werkstatt__fakten li {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .werkstatt__fakten li:not(:last-child)::after {
    content: '';
    width: 1px;
    height: 0.9rem;
    background: var(--oak);
    opacity: 0.7;
  }

  .werkstatt__figure {
    margin: 0;
  }

  .werkstatt__frame {
    overflow: hidden;
    margin-left: auto;
  }

  .werkstatt__frame :global(img),
  .werkstatt__video {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }

  @media (hover: hover) {
    .werkstatt__figure:hover :global(img),
    .werkstatt__figure:hover .werkstatt__video {
      transform: scale(1.03);
    }
  }

  .werkstatt__figure figcaption {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.1rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.6);
  }

  .werkstatt__figure figcaption::before {
    content: '';
    flex: none;
    width: 2.5rem;
    height: 1px;
    background: var(--oak);
  }

  @media (max-width: 899px) {
    .werkstatt__grid {
      grid-template-columns: 1fr;
    }
    /* Mobil: Bild oben, Text darunter */
    .werkstatt__figure {
      order: -1;
      margin-bottom: clamp(2rem, 5vh, 3rem);
    }
  }
</style>
