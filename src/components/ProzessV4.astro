---
import GridLines from './GridLines.astro';

const schritte = [
  { nr: '01', titel: 'Beratung vor Ort', text: 'Wir sehen uns Ihren Raum an, nehmen Maß und hören zu. Erst dann sprechen wir über Lösungen.' },
  { nr: '02', titel: 'Entwurf & Material', text: 'Sie erhalten einen Entwurf mit Materialmustern zum Anfassen — Holz, Furnier, Oberfläche. Entschieden wird am Original.' },
  { nr: '03', titel: 'Fertigung in Pankow', text: 'Ihr Möbel entsteht in unserer Werkstatt in der Treseburger Straße. Ein Ansprechpartner, kurze Wege.' },
  { nr: '04', titel: 'Montage & Übergabe', text: 'Wir montieren sauber, stellen ein und übergeben besenrein. Kleine Nacharbeiten gehören dazu.' },
];
---

<section class="section section--warm has-grid prozess4" id="prozess-v4" aria-label="Arbeitsweise">
  <GridLines variant="paper" />
  <div class="wrap">
    <div class="prozess4__head">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(05)</span>So arbeiten wir</p>
      <h2 class="headline--v4 reveal">Vier Schritte, ein Ergebnis.</h2>
    </div>

    <ol class="prozess4__track">
      <span class="prozess4__line" aria-hidden="true"></span>
      {
        schritte.map((s, i) => (
          <li class="prozess4__step reveal" style={`--reveal-delay: ${i * 0.08}s`} data-pos={i % 2 === 0 ? 'up' : 'down'}>
            <span class="prozess4__dot" aria-hidden="true" />
            <div class="prozess4__card">
              <span class="prozess4__nr" aria-hidden="true">{s.nr}</span>
              <h3 class="prozess4__titel">{s.titel}</h3>
              <p class="prozess4__text">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .prozess4__track {
    list-style: none;
    margin-top: clamp(3rem, 8vh, 5rem);
    padding: 0;
  }

  .prozess4__nr {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--oak);
    margin-bottom: 0.75rem;
  }
  .prozess4__titel {
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    letter-spacing: -0.02em;
  }
  .prozess4__text {
    margin-top: 0.6rem;
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 32ch;
  }

  /* ---------- Desktop: horizontale Zeitachse ---------- */
  @media (min-width: 900px) {
    .prozess4__track {
      position: relative;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: clamp(1rem, 2vw, 2rem);
      min-height: 28rem;
    }
    .prozess4__line {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--oak-line);
    }
    .prozess4__step {
      position: relative;
    }
    .prozess4__dot {
      position: absolute;
      top: 50%;
      left: 0;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--oak);
      transform: translate(-50%, -50%);
      z-index: 1;
    }
    .prozess4__card {
      position: absolute;
      left: 0;
      right: clamp(1rem, 2vw, 2rem);
    }
    /* abwechselnd über / unter der Linie, mit Steg zum Punkt */
    .prozess4__step[data-pos='up'] .prozess4__card {
      bottom: calc(50% + 2rem);
    }
    .prozess4__step[data-pos='down'] .prozess4__card {
      top: calc(50% + 2rem);
    }
    .prozess4__card::before {
      content: '';
      position: absolute;
      left: 0;
      width: 1px;
      height: 1.4rem;
      background: var(--oak-line);
    }
    .prozess4__step[data-pos='up'] .prozess4__card::before {
      bottom: -1.6rem;
    }
    .prozess4__step[data-pos='down'] .prozess4__card::before {
      top: -1.6rem;
    }
  }

  /* ---------- Mobil: horizontales Scroll-Snap-Band ---------- */
  @media (max-width: 899px) {
    .prozess4__track {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-padding-left: var(--gutter);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      padding-bottom: 1rem;
    }
    .prozess4__line {
      display: none;
    }
    .prozess4__step {
      flex: 0 0 85%;
      scroll-snap-align: start;
    }
    .prozess4__dot {
      display: none;
    }
    .prozess4__card {
      height: 100%;
      padding: clamp(1.5rem, 5vw, 2rem);
      border: 1px solid var(--oak-line);
      background: color-mix(in srgb, var(--paper) 60%, transparent);
      border-radius: 3px;
    }
    .prozess4__text {
      max-width: none;
    }
  }
</style>
