---
/**
 * Über uns v5 — „Das Manifest": Die Selbstauskunft als ein großer
 * typografischer Satzblock, der sich Wort für Wort mit dem Scroll aufhellt
 * (reaktiviert initManifest aus stage.ts). Die beiden Fotos hängen nicht mehr
 * als Mini-Galerie daneben (das erledigt jetzt „Aus der Werkstatt"), sondern
 * sind als kleine Inline-Fenster direkt in den Satz eingewoben und falten
 * sich beim Eintritt in den Viewport auf — der Text gleitet auseinander.
 * Darunter eine Werkplan-Legende (selbstzeichnende Hairline, Abb. 01/02).
 */
import { Image } from 'astro:assets';
import GridLines from './GridLines.astro';
import { ueberUnsImages } from '../data/images';

const [bib, bank] = ueberUnsImages; // 2480 Bibliothek, 2470 Fensterbank

type Wort = { w: string; key?: boolean };
const worte = (s: string, key = false): Wort[] => s.split(' ').map((w) => ({ w, key }));

type Segment = { text: Wort[] } | { bild: (typeof ueberUnsImages)[number]; nr: string; fd: string };

// Der Satzfluss: Bilder stehen dort, wo sie inhaltlich hingehören —
// die Bibliothek beim Handwerksanspruch, die Fensterbank vor dem Schlusssatz.
const manifest: Segment[] = [
  { text: worte('Wir sind eine') },
  { text: worte('Meistertischlerei', true) },
  { text: worte('in Berlin-Pankow.') },
  { bild: bib, nr: '01', fd: '0.1s' },
  { text: worte('Vom ersten Aufmaß bis zur Montage entsteht jedes Stück in unserer') },
  { text: worte('eigenen Werkstatt', true) },
  { text: worte('— Einbaumöbel, Restaurierungen, Innenausbau.') },
  { bild: bank, nr: '02', fd: '0.35s' },
  { text: worte('Kein Katalog, keine Serie. Was wir bauen, soll') },
  { text: worte('bleiben.', true) },
];

// Legende im Format der übrigen Annotationen („Werkstück, Material · Ort")
const legende = [
  { nr: 'Abb. 01', text: bib.caption.replace(' — ', ' · ') },
  { nr: 'Abb. 02', text: bank.caption.replace(' — ', ' · ') },
];
---

<section class="ueber5 section has-grid" id="ueber-uns-v4" aria-label="Über uns">
  <GridLines variant="paper" />
  <span class="wm ueber5__wm" aria-hidden="true" data-drift="46">01</span>

  <div class="wrap ueber5__inner">
    <p class="eyebrow reveal"><span class="eyebrow__idx">(01)</span>Über uns</p>
    <h2 class="ueber5__vh">Über uns — Meistertischlerei in Berlin-Pankow</h2>

    <p class="ueber5__manifest" data-manifest>
      {
        manifest.map((seg) =>
          'text' in seg ? (
            seg.text.map(({ w, key }) => (
              <span class:list={['manifest-word', 'mw', { 'mw--key': key }]}>{w}</span>
            ))
          ) : (
            <span class="ufig" style={`--fd: ${seg.fd}`}>
              <span class="ufig__frame photo">
                <Image
                  src={seg.bild.src}
                  alt={seg.bild.alt}
                  widths={[280, seg.bild.src.width]}
                  sizes="9rem"
                  quality={80}
                />
              </span>
              <sup class="ufig__nr" aria-hidden="true">{seg.nr}</sup>
            </span>
          ),
        )
      }
    </p>

    <div class="ueber5__legend reveal" data-rail data-axis="x">
      <span class="ueber5__rail" aria-hidden="true">
        <span class="ueber5__railfill" data-rail-fill></span>
      </span>
      <div class="ueber5__legendrow">
        <ul class="ueber5__abbs">
          {
            legende.map((l) => (
              <li class="wp-anno">
                <span class="wp-anno__mark" aria-hidden="true" />
                <span>
                  <span class="wp-anno__nr">{l.nr}</span> — {l.text}
                </span>
              </li>
            ))
          }
        </ul>
        <a href="#werkstatt-v4" class="link-line ueber5__more" data-cursor="link">
          Mehr über die Werkstatt
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .ueber5 {
    position: relative;
    overflow: hidden;
  }
  .ueber5__wm {
    top: -0.05em;
    right: -0.04em;
    font-size: clamp(11rem, 26vw, 20rem);
  }
  .ueber5__inner {
    position: relative;
    z-index: 1;
  }
  .ueber5__vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* Der Satzblock: Typografie ist hier das Gestaltungselement */
  .ueber5__manifest {
    margin-top: clamp(2.25rem, 6vh, 3.75rem);
    max-width: none;
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(1.9rem, 1.05rem + 3.4vw, 3.7rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    text-wrap: pretty;
    color: var(--ink);
  }
  .mw {
    /* Wortweise Scroll-Aufhellung: Opacity setzt stage.ts (initManifest) */
    display: inline-block;
    margin-right: 0.24em;
  }
  .mw--key {
    color: var(--oak);
  }

  /* Inline-Fenster im Satzfluss: falten sich von 0 auf Zielbreite auf */
  .ufig {
    display: inline-flex;
    align-items: flex-end;
    position: relative;
    vertical-align: -0.14em;
    margin-right: 0.24em;
  }
  .ufig__frame {
    display: inline-block;
    width: 0;
    height: 0.95em;
    overflow: hidden;
    background: var(--paper-dim);
    border-radius: 1px;
    transition: width 1s var(--ease-curtain);
    transition-delay: var(--fd, 0s);
  }
  .is-figs-in .ufig__frame {
    width: 2.3em;
  }
  .ufig__frame :global(img) {
    width: 2.3em;
    max-width: none;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .ufig:hover .ufig__frame :global(img) {
    transform: scale(1.08);
  }
  .ufig__nr {
    font-family: var(--font-mono);
    font-size: 0.28em;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--oak);
    margin-left: 0.5em;
    align-self: flex-start;
    line-height: 1;
    transform: translateY(0.35em);
  }

  /* Werkplan-Legende: Hairline zeichnet sich mit dem Scroll (initRails) */
  .ueber5__legend {
    margin-top: clamp(3rem, 7vh, 4.5rem);
  }
  .ueber5__rail {
    display: block;
    position: relative;
    height: 1px;
    background: var(--oak-line);
    overflow: hidden;
  }
  .ueber5__railfill {
    position: absolute;
    inset: 0;
    background: var(--oak);
    transform: scaleX(0);
    transform-origin: left;
  }
  .ueber5__legendrow {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
    margin-top: 1.1rem;
  }
  .ueber5__abbs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .ueber5__more {
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .ueber5__manifest {
      line-height: 1.34;
    }
    /* Mobil etwas größere Fenster, damit die Motive lesbar bleiben */
    .is-figs-in .ufig__frame {
      width: 2.7em;
    }
    .ufig__frame :global(img) {
      width: 2.7em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ufig__frame,
    .ufig__frame :global(img) {
      transition: none;
    }
    .ueber5 .ufig__frame {
      width: 2.3em;
    }
  }
</style>

<script>
  // Auffalten der Inline-Fenster, sobald das Manifest im Viewport steht.
  // Die Wort-Aufhellung selbst übernimmt initManifest (stage.ts).
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const man = document.querySelector<HTMLElement>('#ueber-uns-v4 [data-manifest]');
  if (man) {
    if (reduced) {
      man.classList.add('is-figs-in');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              man.classList.add('is-figs-in');
              io.disconnect();
            }
          }
        },
        { threshold: 0.25 },
      );
      io.observe(man);
    }
  }
</script>
