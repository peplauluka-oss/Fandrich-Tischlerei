---
/**
 * Über uns v13 — kuratiert aus 5 echten Tischler-/Zimmerer-Referenzseiten
 * (Archi Carpenter, Young & Son Woodworks, Woodworks-Template, Jake Thompson
 * Woodworks, Zonce Woodworking). Kernbeobachtung über alle fünf hinweg:
 *  - Durchgehend fette, klare Sans-Serif-Headlines — keine zurückhaltende
 *    Editorial-Serife. Deshalb hier Inter statt Fraunces/Lora.
 *  - Keine eingefärbten "Keyword"-Wörter im Fließtext — Farbe wird sparsam
 *    für Buttons/Karten eingesetzt, nicht zum Hervorheben einzelner Begriffe.
 *  - „Holz" kommt bei allen fünf ausschließlich aus echter Fotografie (Hero-
 *    Foto, Material-Nahaufnahme) — NIE aus einer Flächen-Textur hinter Text.
 *    Genau das hatte den vorherigen Anlauf ruiniert: eine synthetische
 *    Maserung sieht neben echten Fotos billig aus und untergräbt den
 *    hochwertigen Eindruck. Hintergrund deshalb wieder schlicht/hell.
 *  - Kurze Beleg-Fakten als eigenständige, solide Karten (nicht dünne
 *    Outline-Pins) — Referenz: Archi Carpenters vierteiliges Feature-Grid.
 * Bild-Seite (Foto-Karten, Fakten-Tags, Duoton-Enthüllung) bleibt
 * unverändert — die war laut Betreiber bereits gut.
 */
import { Image } from 'astro:assets';
import { ueberUnsImages } from '../data/images';

const [bib, bank] = ueberUnsImages; // 2480 Bibliothek, 2470 Fensterbank
const fakten = ['Meisterbetrieb', 'Eigene Werkstatt'];
---

<section class="ueber7 section" id="ueber-uns-v4" aria-label="Über uns">
  <div class="wrap ueber7__grid">
    <span class="ueber7__spine" aria-hidden="true" data-rail data-axis="y">
      <span class="ueber7__spinefill" data-rail-fill></span>
    </span>

    <div class="ueber7__copy">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(01)</span>Über uns</p>
      <h2 class="headline--v4 ueber7__head-alt split">Vom Aufmaß bis zur Montage.</h2>

      <p class="ueber7__lead lead reveal" style="--reveal-delay: 0.05s">
        Wir sind eine Meistertischlerei in Berlin-Pankow.
      </p>
      <p class="ueber7__body reveal" style="--reveal-delay: 0.1s">
        Vom ersten Aufmaß bis zur Montage entsteht jedes Stück in unserer eigenen Werkstatt —
        Einbaumöbel, Restaurierungen, Innenausbau.
      </p>
      <p class="ueber7__body reveal" style="--reveal-delay: 0.15s">
        Wir arbeiten mit Massivholz und ausgesuchten Furnieren, und dort, wo es das Möbel
        verlangt, mit handgeschnittenen Verbindungen. Was wir bauen, soll bleiben.
      </p>

      <div class="ueber7__actions reveal" style="--reveal-delay: 0.2s">
        <a href="#werkstatt-v4" class="btn btn--oak ueber7__cta" data-cursor="link">
          Mehr über die Werkstatt <span class="arrow" aria-hidden="true">→</span>
        </a>
        <ul class="ueber7__fakten">
          {fakten.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>

    <div class="ueber7__stage">
      <figure class="ueber7__frame ueber7__frame--a" data-reveal data-drift="22">
        <div class="ueber7__card">
          <span class="ueber7__photo photo">
            <Image
              src={bib.src}
              alt={bib.alt}
              widths={[284, bib.src.width]}
              sizes="(min-width: 900px) 17rem, 58vw"
              loading="eager"
              quality={80}
            />
          </span>
          <span class="ueber7__tag">Massivholz · Handarbeit</span>
        </div>
        <figcaption class="ueber7__loc">Einbaubibliothek — Prenzlauer Berg</figcaption>
      </figure>

      <figure class="ueber7__frame ueber7__frame--b" data-reveal style="--rd: 0.18s" data-drift="-30">
        <div class="ueber7__card">
          <span class="ueber7__photo photo">
            <Image
              src={bank.src}
              alt={bank.alt}
              widths={[240, bank.src.width]}
              sizes="(min-width: 900px) 13rem, 44vw"
              loading="eager"
              quality={80}
            />
          </span>
          <span class="ueber7__tag">Maßanfertigung</span>
        </div>
        <figcaption class="ueber7__loc">Fensterbank mit Stauraum — Pankow</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Kein Textur-Hintergrund mehr — keine der fünf Referenzseiten legt Holz
     als Fläche hinter Text, nur als echtes Foto. Ein synthetisches Muster
     wirkt neben unseren echten Fotos billig statt hochwertig. Schlichter,
     warmer Ton bleibt (getestet, für sich genommen nie kritisiert). */
  .ueber7 {
    position: relative;
    overflow: hidden;
    background: #f2e6d1;
  }
  .ueber7__grid {
    position: relative;
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  /* Fortschritts-Spindel zwischen den Spalten — funktional (zeigt
     Lesefortschritt der Sektion), nicht bloß Dekor. Nur Desktop. */
  .ueber7__spine {
    display: none;
    position: absolute;
    top: 0.3em;
    bottom: 0.3em;
    left: 50%;
    width: 2px;
    background: var(--oak-line);
    transform: translateX(-50%);
    overflow: hidden;
    border-radius: 1px;
  }
  .ueber7__spinefill {
    position: absolute;
    inset: 0;
    background: var(--oak);
    transform: scaleY(0);
    transform-origin: top;
  }
  @media (min-width: 900px) {
    .ueber7__spine {
      display: block;
    }
  }

  /* Fette Sans-Headline statt Fraunces/Lora — durchgehendes Muster aller
     fünf Referenzseiten. Kein neuer Font: Inter (Body) ist schon geladen. */
  .ueber7__head-alt {
    font-family: var(--font-body);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .ueber7__lead {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
  }
  .ueber7__body {
    margin-top: 1.1rem;
    color: var(--ink);
    max-width: 46ch;
  }

  .ueber7__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  /* Ehrliche Fakten-Karten: kein Fake-Rating, nur belegte Aussagen — als
     solide Karten mit Schatten statt dünner Outline-Pins (Referenz: Archi
     Carpenters Feature-Grid), damit die Textspalte nicht "leblos" wirkt. */
  .ueber7__fakten {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .ueber7__fakten li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    background: var(--paper);
    border-radius: 0.6rem;
    padding: 0.6rem 1.05rem;
    box-shadow:
      0 1px 2px rgba(43, 37, 35, 0.05),
      0 10px 18px -12px rgba(43, 37, 35, 0.3);
  }
  .ueber7__fakten li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--oak);
  }

  /* Bühne: zwei große, weich gerundete Foto-Karten, versetzt */
  .ueber7__stage {
    position: relative;
    min-height: clamp(21rem, 35vw, 27rem);
  }
  .ueber7__frame {
    position: absolute;
    margin: 0;
  }
  .ueber7__frame--a {
    top: 0;
    left: clamp(0px, 4vw, 2rem);
    width: min(19rem, 62%);
    z-index: 1;
  }
  .ueber7__frame--b {
    top: clamp(6.5rem, 16vw, 9.5rem);
    right: 0;
    left: auto;
    width: min(15rem, 50%);
    z-index: 2;
  }

  .ueber7__card {
    position: relative;
    display: block;
    border-radius: 1.75rem;
    overflow: visible;
    box-shadow:
      0 1px 2px rgba(43, 37, 35, 0.07),
      0 22px 40px -18px rgba(43, 37, 35, 0.34);
  }
  .ueber7__photo {
    display: block;
    overflow: hidden;
    border-radius: 1.75rem;
    aspect-ratio: 2 / 3;
    background: var(--paper-dim);
  }
  .ueber7__frame--a .ueber7__photo {
    aspect-ratio: 213 / 320;
  }
  .ueber7__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Basiszustand vor der Enthüllung: entsättigt — die Farb-Ankunft ist
       die eigentliche Bewegung, nicht nur ein Fade. */
    filter: grayscale(1) contrast(1.08) brightness(0.9);
    transform: scale(1.1);
    transition:
      filter 1.1s var(--ease-out),
      transform 1.4s var(--ease-curtain);
    transition-delay: var(--rd, 0s);
  }
  .ueber7__frame[data-reveal].is-in .ueber7__photo :global(img) {
    filter: var(--photo-filter);
    transform: scale(1);
  }

  /* Curtain-Clip zusätzlich zur Duoton-Ankunft */
  .ueber7__frame[data-reveal] .ueber7__photo {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-curtain);
    transition-delay: var(--rd, 0s);
  }
  .ueber7__frame[data-reveal].is-in .ueber7__photo {
    clip-path: inset(0 0 0 0);
  }

  .ueber7__frame:hover .ueber7__photo :global(img) {
    transform: scale(1.045);
  }

  /* Schwebender Fakten-Tag, überlappt die untere Kartenkante — Referenz:
     Material-/Service-Badges direkt auf dem Foto statt stiller Caption. */
  .ueber7__tag {
    position: absolute;
    left: 0.9rem;
    bottom: -0.85rem;
    z-index: 1;
    background: var(--oak);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    border-radius: 999px;
    padding: 0.5rem 1rem;
    box-shadow: 0 10px 18px -8px rgba(43, 37, 35, 0.45);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
    transition-delay: calc(var(--rd, 0s) + 0.55s);
  }
  .ueber7__frame[data-reveal].is-in .ueber7__tag {
    opacity: 1;
    transform: none;
  }

  .ueber7__loc {
    margin-top: 1.4rem;
    max-width: 14rem;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .ueber7__photo :global(img) {
      filter: var(--photo-filter);
      transform: none;
      transition: none;
    }
    .ueber7__frame[data-reveal] .ueber7__photo {
      clip-path: none;
      transition: none;
    }
    .ueber7__tag {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .ueber7__grid {
      grid-template-columns: 1fr;
      gap: clamp(3.5rem, 10vh, 4.5rem);
    }
    .ueber7__stage {
      min-height: clamp(17rem, 76vw, 21rem);
    }
    .ueber7__frame--a {
      left: 0;
      width: 56%;
    }
    .ueber7__frame--b {
      top: clamp(5rem, 28vw, 6.5rem);
      width: 46%;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const frames = document.querySelectorAll<HTMLElement>('#ueber-uns-v4 [data-reveal]');
  if (reduced) {
    frames.forEach((f) => f.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.25 },
    );
    frames.forEach((f) => io.observe(f));
  }
</script>
