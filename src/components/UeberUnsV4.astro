---
/**
 * Über uns v15 — Redesign nach Feedback (Skills: impeccable/taste/emil).
 *
 * Weg vom AI-Slop:
 *  - Keine Section-Eyebrow + keine „(01)"-Nummer mehr (impeccable-Ban:
 *    Eyebrow-/Nummern-Grammatik über jeder Sektion).
 *  - Das Panel bekommt ECHTES Holz (dunkel getönte Kiefer-Textur) statt der
 *    verbotenen feTurbulence-Prozedurmaserung + Streifen-Gradient.
 *  - Die 4 „Baukasten"-Weißkarten mit braunem Quadrat weichen transparenten
 *    Glas-Cards, durch die das Holz durchscheint — kompakt, mit Spring-Lift.
 *
 * De-Dup-Gesetz gewahrt: beide Über-uns-Fotos (2480, 2470) je 1×.
 */
import { Image } from 'astro:assets';
import { ueberUnsImages } from '../data/images';
import woodTex from '../assets/textures/holz-kiefer.jpeg';

const [bib, bank] = ueberUnsImages; // 2480 Bibliothek, 2470 Fensterbank

// Vier Grundwerte — komprimiert aus der Firmenphilosophie, je ein Satz.
const werte = [
  {
    t: 'Kompromisslose Qualität',
    d: 'Präzision und Sorgfalt in jedem Detail — ausgeführt, als schaute uns ein Meister über die Schulter.',
  },
  {
    t: 'Ehrliche Verbindlichkeit',
    d: 'Ein Wort ist ein Wort. Wir versprechen nur, was wir halten — pünktlich und zuverlässig.',
  },
  {
    t: 'Beratung & fairer Wert',
    d: 'Nicht die Billigsten, sondern die Besten: ehrliche Beratung, ein Ergebnis, das seinen Wert behält.',
  },
  {
    t: 'Respekt & Fortschritt',
    d: 'Wir begegnen jedem mit Respekt, fokussieren uns auf Lösungen und lassen die Arbeit sprechen.',
  },
];
---

<section class="ueber8 section" id="ueber-uns-v4" aria-label="Über uns">
  <div class="wrap">
    <header class="ueber8__head">
      <h2 class="ueber8__title split">Vom Aufmaß bis zur Montage.</h2>
      <p class="ueber8__intro reveal">
        Wir sind eine <strong>Meistertischlerei in Berlin-Pankow</strong> — Fenster, Türen und
        Möbel entstehen vom ersten Aufmaß bis zur Montage aus einer Hand.
      </p>
    </header>

    <div class="ueber8__panel reveal" style={`--panel-tex: url(${woodTex.src})`}>
      <div class="ueber8__stage">
        <figure class="ueber8__frame ueber8__frame--a" data-reveal data-drift="18">
          <div class="ueber8__card">
            <span class="ueber8__photo photo">
              <Image
                src={bib.src}
                alt={bib.alt}
                widths={[284, bib.src.width]}
                sizes="(min-width: 900px) 17rem, 58vw"
                loading="lazy"
                quality={80}
              />
            </span>
          </div>
          <figcaption class="ueber8__loc">Einbaubibliothek — Prenzlauer Berg</figcaption>
        </figure>

        <figure class="ueber8__frame ueber8__frame--b" data-reveal style="--rd: 0.16s" data-drift="-26">
          <div class="ueber8__card">
            <span class="ueber8__photo photo">
              <Image
                src={bank.src}
                alt={bank.alt}
                widths={[240, bank.src.width]}
                sizes="(min-width: 900px) 13rem, 44vw"
                loading="lazy"
                quality={80}
              />
            </span>
          </div>
          <figcaption class="ueber8__loc">Fensterbank mit Stauraum — Pankow</figcaption>
        </figure>

        <span class="ueber8__badge" data-reveal style="--rd: 0.35s">
          <strong>Meister&shy;betrieb</strong>
          <span>Tischlerei · Pankow</span>
        </span>
      </div>

      <div class="ueber8__text">
        <p class="ueber8__body">
          Jedes Stück entsteht in unserer eigenen Werkstatt — Einbaumöbel, Restaurierungen,
          Innenausbau. Wir arbeiten mit Massivholz und ausgesuchten Furnieren, und dort, wo es das
          Möbel verlangt, mit handgeschnittenen Verbindungen.
        </p>
        <p class="ueber8__motto">Was wir bauen, soll bleiben.</p>
        <a href="#werkstatt-v4" class="btn btn--oak ueber8__cta" data-cursor="link">
          Mehr über die Werkstatt <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="ueber8__philo">
      <h3 class="ueber8__philo-t reveal split">Der Kreislauf guter Arbeit</h3>
      <p class="ueber8__philo-lead reveal" style="--reveal-delay: 0.08s">
        Dienstleistung ist ein Kreislauf: Wer heute leistet, ist morgen selbst Kunde. Unser Antrieb
        ist es, ihn zu perfektionieren — mit Zufriedenheit auf beiden Seiten.
      </p>

      <ul class="ueber8__values">
        {
          werte.map((f, i) => (
            <li class="ueber8__value reveal" style={`--reveal-delay: ${0.05 + i * 0.08}s`}>
              <span class="ueber8__value-rule" aria-hidden="true" />
              <h4 class="ueber8__value-t">{f.t}</h4>
              <p class="ueber8__value-d">{f.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .ueber8 {
    position: relative;
    background: transparent;
  }

  /* Kopf: fette Sans-Headline direkt auf dem Holz — kein Eyebrow, keine Nummer */
  .ueber8__head {
    max-width: 46ch;
  }
  .ueber8__title {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--wood-ink);
    text-wrap: balance;
  }
  .ueber8__intro {
    margin-top: clamp(1.1rem, 2.5vh, 1.6rem);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.55;
    color: var(--wood-ink);
    max-width: 52ch;
  }
  .ueber8__intro strong {
    font-weight: 700;
  }

  /* Story-Panel: ECHTES Holz (dunkel getönte Kiefer-Textur), kein feTurbulence */
  .ueber8__panel {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-radius: clamp(1.25rem, 2.5vw, 2rem);
    overflow: hidden;
    padding: clamp(1.75rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    color: var(--paper);
    background-color: #241811;
    background-image:
      linear-gradient(160deg, rgba(18, 12, 7, 0.84), rgba(36, 25, 16, 0.9)),
      var(--panel-tex, none);
    background-size: cover, cover;
    background-position: center, center;
    box-shadow:
      0 1px 2px rgba(43, 37, 35, 0.1),
      0 40px 70px -34px rgba(28, 18, 10, 0.7);
  }

  /* Foto-Diptychon im Panel */
  .ueber8__stage {
    position: relative;
    min-height: clamp(20rem, 32vw, 25rem);
  }
  .ueber8__frame {
    position: absolute;
    margin: 0;
  }
  .ueber8__frame--a {
    top: 0;
    left: 0;
    width: min(17rem, 60%);
    z-index: 1;
  }
  .ueber8__frame--b {
    top: clamp(5.5rem, 14vw, 8.5rem);
    right: 0;
    width: min(13rem, 46%);
    z-index: 2;
  }
  .ueber8__card {
    border-radius: 1.1rem;
    overflow: hidden;
    box-shadow: 0 24px 44px -20px rgba(0, 0, 0, 0.6);
  }
  .ueber8__photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background: #2a1d14;
  }
  .ueber8__frame--a .ueber8__photo {
    aspect-ratio: 213 / 320;
  }
  .ueber8__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05) brightness(0.85);
    transform: scale(1.12);
    transition:
      filter 1.1s var(--ease-out),
      transform 1.4s var(--ease-expo);
    transition-delay: var(--rd, 0s);
  }
  .ueber8__frame[data-reveal].is-in .ueber8__photo :global(img) {
    filter: var(--photo-filter);
    transform: scale(1);
  }
  .ueber8__frame[data-reveal] .ueber8__card {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-expo);
    transition-delay: var(--rd, 0s);
  }
  .ueber8__frame[data-reveal].is-in .ueber8__card {
    clip-path: inset(0 0 0 0);
  }
  .ueber8__frame:hover .ueber8__photo :global(img) {
    transform: scale(1.05);
  }
  .ueber8__loc {
    margin-top: 0.8rem;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: rgba(250, 247, 242, 0.62);
  }

  /* Ehrlicher Badge, ragt über das Foto (kein erfundenes Gründungsjahr) */
  .ueber8__badge {
    position: absolute;
    left: -0.6rem;
    bottom: clamp(3.5rem, 8vw, 5.5rem);
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--paper);
    color: var(--ink);
    padding: 0.85rem 1.15rem;
    border-radius: 0.8rem;
    box-shadow: 0 18px 34px -14px rgba(0, 0, 0, 0.55);
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-expo);
    transition-delay: var(--rd, 0s);
  }
  .ueber8__badge.is-in {
    opacity: 1;
    transform: none;
  }
  .ueber8__badge strong {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1;
    hyphens: manual;
  }
  .ueber8__badge span {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--oak);
    font-weight: 600;
  }

  /* Textseite im Panel (hell auf Holz) */
  .ueber8__body {
    color: rgba(250, 247, 242, 0.82);
    max-width: 46ch;
  }
  .ueber8__motto {
    margin-top: 1.1rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    line-height: 1.3;
    color: var(--oak);
  }
  .ueber8__cta {
    margin-top: 1.9rem;
  }

  /* Philosophie — auf hellem Holz, Rhythmuswechsel nach dem dunklen Panel */
  .ueber8__philo {
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }
  .ueber8__philo-t {
    max-width: 26ch;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
    color: var(--wood-ink);
    text-wrap: balance;
  }
  .ueber8__philo-lead {
    margin-top: 1rem;
    max-width: 56ch;
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: rgba(58, 42, 28, 0.78);
  }

  /* Werte als transparente Glas-Cards — das Holz scheint durch (deine Idee),
     kein braunes Symbol, kompakter Rhythmus, Spring-Lift bei Hover. */
  .ueber8__values {
    list-style: none;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: stretch;
    gap: clamp(0.8rem, 1.4vw, 1.15rem);
  }
  .ueber8__value {
    position: relative;
    padding: clamp(1.25rem, 2vw, 1.7rem);
    border-radius: 14px;
    background: rgba(255, 251, 244, 0.46);
    backdrop-filter: blur(7px) saturate(1.05);
    -webkit-backdrop-filter: blur(7px) saturate(1.05);
    border: 1px solid rgba(120, 88, 56, 0.2);
    box-shadow: 0 14px 32px -22px rgba(43, 30, 18, 0.5);
    transition:
      transform 0.5s var(--ease-expo),
      background 0.4s var(--ease-out),
      box-shadow 0.5s var(--ease-expo);
  }
  .ueber8__value:hover {
    transform: translateY(-5px);
    background: rgba(255, 252, 246, 0.72);
    box-shadow: 0 26px 44px -24px rgba(43, 30, 18, 0.55);
  }
  .ueber8__value-rule {
    display: block;
    width: 2rem;
    height: 2px;
    border-radius: 1px;
    background: var(--oak);
    margin-bottom: 0.95rem;
  }
  .ueber8__value-t {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--wood-ink);
  }
  .ueber8__value-d {
    margin-top: 0.4rem;
    font-size: 0.84rem;
    line-height: 1.5;
    color: rgba(58, 42, 28, 0.74);
  }

  @media (prefers-reduced-motion: reduce) {
    .ueber8__photo :global(img) {
      filter: var(--photo-filter);
      transform: none;
      transition: none;
    }
    .ueber8__frame[data-reveal] .ueber8__card {
      clip-path: none;
      transition: none;
    }
    .ueber8__badge {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .ueber8__value {
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .ueber8__panel {
      grid-template-columns: 1fr;
      gap: clamp(2rem, 6vw, 3rem);
    }
    .ueber8__stage {
      min-height: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
      align-items: start;
    }
    .ueber8__frame {
      position: static;
      width: auto;
    }
    .ueber8__frame--b {
      margin-top: 1.75rem;
    }
    .ueber8__badge {
      top: -0.5rem;
      bottom: auto;
      left: 0.4rem;
    }
    .ueber8__values {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .ueber8__values {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLElement>('#ueber-uns-v4 [data-reveal]');
  if (reduced) {
    items.forEach((f) => f.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    items.forEach((f) => io.observe(f));
  }
</script>
