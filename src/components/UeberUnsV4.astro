---
/**
 * Über uns v16 — „Awwwards"-Umbau (Probe, Skills: emil/impeccable/taste).
 *
 *  1) „Vom Aufmaß bis zur Montage" ist aus dem dunklen Kasten ausgebrochen:
 *     Split-Screen-Parallax (CraftSplit-Island) — links sticky Typo mit
 *     zeilenweisem Masken-Reveal, rechts scrollende Bilder mit Parallax,
 *     magnetischer CTA.
 *  2) „Der Kreislauf guter Arbeit" wird zum Interaktionsmodell
 *     (PhilosophyStack-Island): Desktop = Sticky-Scroll-Stack (Karten-Deck),
 *     Mobil = Snap-Swipe-Karussell, mit riesigen Serif-Wasserzeichen-Zahlen.
 *
 * Holz-Thema bleibt (Glas über Kiefer), Fraunces/Inter bleiben.
 * De-Dup-Gesetz gewahrt: beide Über-uns-Fotos (2480, 2470) je 1×.
 */
import { getImage } from 'astro:assets';
import { ueberUnsImages } from '../data/images';
import woodTex from '../assets/textures/holz-kiefer.jpeg';
import CraftSplit, { type CraftImage } from './CraftSplit';
import PhilosophyStack, { type Wert } from './PhilosophyStack';

// Optimierte WebP-Quellen für die Islands (Astro kann in TSX nicht optimieren).
const craftImages: CraftImage[] = await Promise.all(
  ueberUnsImages.map(async (b): Promise<CraftImage> => {
    const opt = await getImage({ src: b.src, width: 760, format: 'webp', quality: 80 });
    return {
      src: opt.src,
      alt: b.alt,
      caption: b.caption,
      ratio: b.src.width / b.src.height,
    };
  }),
);

// Holz-Textur für das „wegfliegende Brett" (optimiert).
const coverTex = (await getImage({ src: woodTex, width: 760, format: 'webp', quality: 78 })).src;

// Vier Grundwerte — komprimiert aus der Firmenphilosophie, je ein Satz.
const werte: Wert[] = [
  {
    t: 'Kompromisslose Qualität',
    d: 'Präzision und Sorgfalt in jedem Detail — ausgeführt, als schaute uns ein Meister über die Schulter.',
  },
  {
    t: 'Ehrliche Verbindlichkeit',
    d: 'Ein Wort ist ein Wort. Wir versprechen nur, was wir halten — pünktlich und zuverlässig.',
  },
  {
    t: 'Beratung & fairer Wert',
    d: 'Nicht die Billigsten, sondern die Besten: ehrliche Beratung, ein Ergebnis, das seinen Wert behält.',
  },
  {
    t: 'Respekt & Fortschritt',
    d: 'Wir begegnen jedem mit Respekt, fokussieren uns auf Lösungen und lassen die Arbeit sprechen.',
  },
];
---

<section class="ueber8 section" id="ueber-uns-v4" aria-label="Über uns">
  <div class="wrap">
    <CraftSplit client:visible images={craftImages} coverTex={coverTex} />

    <div class="ueber8__philo">
      <h2 class="ueber8__philo-t split">Der Kreislauf guter Arbeit</h2>
      <p class="ueber8__philo-lead reveal">
        Dienstleistung ist ein Kreislauf: Wer heute leistet, ist morgen selbst Kunde. Unser Antrieb
        ist es, ihn zu perfektionieren — mit Zufriedenheit auf beiden Seiten.
      </p>

      <PhilosophyStack client:visible werte={werte} />
    </div>
  </div>
</section>

<style>
  .ueber8 {
    position: relative;
    background: transparent;
  }

  .ueber8__philo {
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  .ueber8__philo-t {
    max-width: 26ch;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(1.9rem, 3.8vw, 2.9rem);
    line-height: 1.06;
    letter-spacing: -0.024em;
    color: var(--wood-ink);
    text-wrap: balance;
  }
  .ueber8__philo-lead {
    margin-top: 1rem;
    max-width: 56ch;
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: rgba(58, 42, 28, 0.78);
  }
</style>
