---
/**
 * Über uns v6 — „Zwei Werke, ein Anspruch": Zurück zu klarer Hierarchie
 * (Headline, Lead, zwei kurze Absätze statt eines Fließtext-Blocks), aber
 * mit spürbarer Bewegung statt einer Text-auf-Weiß-Wand.
 *
 * Bild-Realität (G2/STATUS.md): beide Fotos sind native 426×640 px, harte
 * Grenze also 284 px Anzeigebreite — sie werden NICHT größer skaliert.
 * Statt das zu kaschieren, werden sie als gerahmte Exponate inszeniert
 * (Passepartout, Schatten, große Oak-Ordnungszahlen) und über Bewegung
 * aufgewertet: Duoton→Farb-Enthüllung beim Eintritt, Curtain-Clip,
 * je eigenes Parallax-Tempo, eine sich mitfüllende Fortschritts-Spindel
 * zwischen Text und Bild, Keyword-Unterstriche, die sich einzeichnen.
 * Keine blueprint-artigen Mono-Bildunterschriften/Ghost-Ziffern hier —
 * das war der „PDF"-Eindruck.
 */
import { Image } from 'astro:assets';
import { ueberUnsImages } from '../data/images';

const [bib, bank] = ueberUnsImages; // 2480 Bibliothek, 2470 Fensterbank
---

<section class="ueber6 section" id="ueber-uns-v4" aria-label="Über uns">
  <div class="wrap ueber6__grid">
    <span class="ueber6__spine" aria-hidden="true" data-rail data-axis="y">
      <span class="ueber6__spinefill" data-rail-fill></span>
    </span>

    <div class="ueber6__copy">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(01)</span>Über uns</p>
      <h2 class="headline--v4 split">Vom Aufmaß bis zur Montage.</h2>

      <p class="ueber6__lead lead reveal" style="--reveal-delay: 0.05s">
        Wir sind eine <span class="key">Meistertischlerei</span> in Berlin-Pankow.
      </p>
      <p class="ueber6__body reveal" style="--reveal-delay: 0.1s">
        Vom ersten Aufmaß bis zur Montage entsteht jedes Stück in unserer{' '}
        <span class="key">eigenen Werkstatt</span> — Einbaumöbel, Restaurierungen, Innenausbau.
      </p>
      <p class="ueber6__body reveal" style="--reveal-delay: 0.15s">
        Wir arbeiten mit <span class="key">Massivholz</span> und ausgesuchten Furnieren, und dort,
        wo es das Möbel verlangt, mit <span class="key">handgeschnittenen Verbindungen</span>. Was
        wir bauen, soll bleiben.
      </p>

      <a href="#werkstatt-v4" class="btn btn--ghost ueber6__cta reveal" style="--reveal-delay: 0.2s" data-cursor="link">
        Mehr über die Werkstatt <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="ueber6__stage">
      <figure class="ueber6__frame ueber6__frame--a" data-reveal data-drift="22">
        <span class="ueber6__mat">
          <span class="ueber6__photo photo">
            <Image
              src={bib.src}
              alt={bib.alt}
              widths={[284, bib.src.width]}
              sizes="(min-width: 900px) 17rem, 58vw"
              loading="eager"
              quality={80}
            />
          </span>
        </span>
        <figcaption class="ueber6__cap">
          <span class="ueber6__nr" aria-hidden="true">01</span>
          <span class="ueber6__capline">Einbaubibliothek, Kirschbaum<br />Prenzlauer Berg</span>
        </figcaption>
      </figure>

      <figure class="ueber6__frame ueber6__frame--b" data-reveal style="--rd: 0.18s" data-drift="-30">
        <span class="ueber6__mat">
          <span class="ueber6__photo photo">
            <Image
              src={bank.src}
              alt={bank.alt}
              widths={[240, bank.src.width]}
              sizes="(min-width: 900px) 13rem, 44vw"
              loading="eager"
              quality={80}
            />
          </span>
        </span>
        <figcaption class="ueber6__cap">
          <span class="ueber6__nr" aria-hidden="true">02</span>
          <span class="ueber6__capline">Fensterbank mit Stauraum<br />Pankow</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .ueber6 {
    position: relative;
    overflow: hidden;
  }
  .ueber6__grid {
    position: relative;
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  /* Fortschritts-Spindel zwischen den Spalten — funktional (zeigt
     Lesefortschritt der Sektion), nicht bloß Dekor. Nur Desktop. */
  .ueber6__spine {
    display: none;
    position: absolute;
    top: 0.3em;
    bottom: 0.3em;
    left: 50%;
    width: 2px;
    background: var(--oak-line);
    transform: translateX(-50%);
    overflow: hidden;
    border-radius: 1px;
  }
  .ueber6__spinefill {
    position: absolute;
    inset: 0;
    background: var(--oak);
    transform: scaleY(0);
    transform-origin: top;
  }
  @media (min-width: 900px) {
    .ueber6__spine {
      display: block;
    }
  }

  .ueber6__lead {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
  }
  .ueber6__body {
    margin-top: 1.1rem;
    color: var(--ink);
    max-width: 46ch;
  }
  .ueber6__cta {
    margin-top: 2.25rem;
  }

  /* Keyword-Unterstriche zeichnen sich mit dem Absatz-Reveal ein —
     an .reveal.is-visible gekoppelt, keine eigene Beobachtung nötig. */
  .ueber6__copy .key {
    position: relative;
  }
  .ueber6__copy .key::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.05em;
    height: 1px;
    background: var(--oak);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
    transition-delay: 0.35s;
  }
  .ueber6__copy .reveal.is-visible .key::after {
    transform: scaleX(1);
  }

  /* Bühne: zwei gerahmte Exponate, versetzt, mit Passepartout */
  .ueber6__stage {
    position: relative;
    min-height: clamp(20rem, 34vw, 26rem);
  }
  .ueber6__frame {
    position: absolute;
    margin: 0;
  }
  .ueber6__frame--a {
    top: 0;
    left: clamp(0px, 4vw, 2rem);
    width: min(18.5rem, 62%);
    z-index: 1;
  }
  .ueber6__frame--b {
    top: clamp(6rem, 15vw, 9rem);
    right: 0;
    left: auto;
    width: min(14.5rem, 50%);
    z-index: 2;
  }

  /* Passepartout: Museums-Mat aus Papierton + weicher Schatten macht aus
     einem notgedrungen kleinen Abzug ein bewusst gerahmtes Exponat. */
  .ueber6__mat {
    display: block;
    background: var(--paper);
    padding: 0.6rem;
    box-shadow:
      0 1px 2px rgba(43, 37, 35, 0.06),
      0 18px 34px -18px rgba(43, 37, 35, 0.32);
  }
  .ueber6__photo {
    display: block;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background: var(--paper-dim);
  }
  .ueber6__frame--a .ueber6__photo {
    aspect-ratio: 213 / 320;
  }
  .ueber6__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Basiszustand vor der Enthüllung: entsättigt — die Farb-Ankunft ist
       die eigentliche Bewegung, nicht nur ein Fade. */
    filter: grayscale(1) contrast(1.08) brightness(0.9);
    transform: scale(1.1);
    transition:
      filter 1.1s var(--ease-out),
      transform 1.4s var(--ease-curtain);
    transition-delay: var(--rd, 0s);
  }
  .ueber6__frame[data-reveal].is-in .ueber6__photo :global(img) {
    filter: var(--photo-filter);
    transform: scale(1);
  }

  /* Curtain-Clip zusätzlich zur Duoton-Ankunft */
  .ueber6__frame[data-reveal] .ueber6__mat {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-curtain);
    transition-delay: var(--rd, 0s);
  }
  .ueber6__frame[data-reveal].is-in .ueber6__mat {
    clip-path: inset(0 0 0 0);
  }

  .ueber6__frame:hover .ueber6__photo :global(img) {
    transform: scale(1.045);
  }

  .ueber6__cap {
    margin-top: 0.85rem;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .ueber6__nr {
    flex: none;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--oak);
    letter-spacing: -0.01em;
  }
  .ueber6__capline {
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .ueber6__photo :global(img) {
      filter: var(--photo-filter);
      transform: none;
      transition: none;
    }
    .ueber6__frame[data-reveal] .ueber6__mat {
      clip-path: none;
      transition: none;
    }
    .ueber6__copy .key::after {
      transform: scaleX(1);
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .ueber6__grid {
      grid-template-columns: 1fr;
      gap: clamp(3rem, 9vh, 4rem);
    }
    .ueber6__stage {
      min-height: clamp(16rem, 74vw, 20rem);
    }
    .ueber6__frame--a {
      left: 0;
      width: 56%;
    }
    .ueber6__frame--b {
      top: clamp(4.5rem, 26vw, 6rem);
      width: 46%;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const frames = document.querySelectorAll<HTMLElement>('#ueber-uns-v4 [data-reveal]');
  if (reduced) {
    frames.forEach((f) => f.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.25 },
    );
    frames.forEach((f) => io.observe(f));
  }
</script>
