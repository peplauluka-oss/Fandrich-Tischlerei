---
/**
 * Über uns v7 — kuratierte Synthese aus Referenz-Screenshots (Betreiber-
 * Input: moderne Construction-/Möbelhersteller-/Service-Sites). Übernommen
 * NICHT 1:1, sondern gefiltert auf das, was zu Handwerk + unseren echten
 * Bild-/Fakten-Grenzen passt:
 *  - Große, weich gerundete Foto-Karten statt schmalem Passepartout.
 *  - Schwebende Fakten-Tags direkt auf den Fotos (Referenz: "High Quality
 *    Materials"-Badges) — aber nur mit Aussagen, die anderswo auf der Seite
 *    bereits belegt sind (Massivholz, Maßanfertigung), keine erfundenen
 *    Trust-Stats (keine Sterne/Kundenzahlen — die Referenzen zeigen genau
 *    das, aber das Projekt verbietet erfundene Fakten).
 *  - CTA als satter Oak-Button (.btn--oak) statt Outline — Referenzen setzen
 *    durchgehend auf volle Farbflächen, nicht auf Ghost-Buttons.
 *  - Kleine, ehrliche Vertrauens-Chips (Meisterbetrieb, Eigene Werkstatt)
 *    als Pendant zu den Bewertungs-/Kundenzahl-Badges der Referenzen.
 * Layout/Bewegung aus v6 bleibt (Duoton-Enthüllung, Parallax, Fortschritts-
 * Spindel, Keyword-Unterstriche) — das war nicht der Kritikpunkt.
 */
import { Image } from 'astro:assets';
import { ueberUnsImages } from '../data/images';

const [bib, bank] = ueberUnsImages; // 2480 Bibliothek, 2470 Fensterbank
const fakten = ['Meisterbetrieb', 'Eigene Werkstatt'];
---

<section class="ueber7 section" id="ueber-uns-v4" aria-label="Über uns">
  <div class="wrap ueber7__grid">
    <span class="ueber7__spine" aria-hidden="true" data-rail data-axis="y">
      <span class="ueber7__spinefill" data-rail-fill></span>
    </span>

    <div class="ueber7__copy">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(01)</span>Über uns</p>
      <h2 class="headline--v4 ueber7__head-alt split">Vom Aufmaß bis zur Montage.</h2>

      <p class="ueber7__lead lead reveal" style="--reveal-delay: 0.05s">
        Wir sind eine <span class="key">Meistertischlerei</span> in Berlin-Pankow.
      </p>
      <p class="ueber7__body reveal" style="--reveal-delay: 0.1s">
        Vom ersten Aufmaß bis zur Montage entsteht jedes Stück in unserer{' '}
        <span class="key">eigenen Werkstatt</span> — Einbaumöbel, Restaurierungen, Innenausbau.
      </p>
      <p class="ueber7__body reveal" style="--reveal-delay: 0.15s">
        Wir arbeiten mit <span class="key">Massivholz</span> und ausgesuchten Furnieren, und dort,
        wo es das Möbel verlangt, mit <span class="key">handgeschnittenen Verbindungen</span>. Was
        wir bauen, soll bleiben.
      </p>

      <div class="ueber7__actions reveal" style="--reveal-delay: 0.2s">
        <a href="#werkstatt-v4" class="btn btn--oak ueber7__cta" data-cursor="link">
          Mehr über die Werkstatt <span class="arrow" aria-hidden="true">→</span>
        </a>
        <ul class="ueber7__fakten">
          {fakten.map((f) => <li>{f}</li>)}
        </ul>
      </div>
    </div>

    <div class="ueber7__stage">
      <figure class="ueber7__frame ueber7__frame--a" data-reveal data-drift="22">
        <div class="ueber7__card">
          <span class="ueber7__photo photo">
            <Image
              src={bib.src}
              alt={bib.alt}
              widths={[284, bib.src.width]}
              sizes="(min-width: 900px) 17rem, 58vw"
              loading="eager"
              quality={80}
            />
          </span>
          <span class="ueber7__tag">Massivholz · Handarbeit</span>
        </div>
        <figcaption class="ueber7__loc">Einbaubibliothek — Prenzlauer Berg</figcaption>
      </figure>

      <figure class="ueber7__frame ueber7__frame--b" data-reveal style="--rd: 0.18s" data-drift="-30">
        <div class="ueber7__card">
          <span class="ueber7__photo photo">
            <Image
              src={bank.src}
              alt={bank.alt}
              widths={[240, bank.src.width]}
              sizes="(min-width: 900px) 13rem, 44vw"
              loading="eager"
              quality={80}
            />
          </span>
          <span class="ueber7__tag">Maßanfertigung</span>
        </div>
        <figcaption class="ueber7__loc">Fensterbank mit Stauraum — Pankow</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .ueber7 {
    position: relative;
    overflow: hidden;
    background: #f2e6d1;
  }
  .ueber7__grid {
    position: relative;
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  /* Fortschritts-Spindel zwischen den Spalten — funktional (zeigt
     Lesefortschritt der Sektion), nicht bloß Dekor. Nur Desktop. */
  .ueber7__spine {
    display: none;
    position: absolute;
    top: 0.3em;
    bottom: 0.3em;
    left: 50%;
    width: 2px;
    background: var(--oak-line);
    transform: translateX(-50%);
    overflow: hidden;
    border-radius: 1px;
  }
  .ueber7__spinefill {
    position: absolute;
    inset: 0;
    background: var(--oak);
    transform: scaleY(0);
    transform-origin: top;
  }
  @media (min-width: 900px) {
    .ueber7__spine {
      display: block;
    }
  }

  /* Test: Lora statt Fraunces (Betreiber empfindet Fraunces als "langweilig",
     zu editorial/fashion — Lora ist wärmer, ruhiger, weniger kontrastreich) */
  .ueber7__head-alt {
    font-family: 'Lora', var(--font-head);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .ueber7__lead {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
  }
  .ueber7__body {
    margin-top: 1.1rem;
    color: var(--ink);
    max-width: 46ch;
  }

  .ueber7__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  /* Ehrliche Vertrauens-Chips: kein Fake-Rating, nur belegte Fakten,
     als leichte Outline-Pills — eine Gewichtsstufe unter dem CTA-Button
     und den satten Foto-Tags. */
  .ueber7__fakten {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .ueber7__fakten li {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink);
    border: 1px solid var(--oak-line);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
  }

  /* Keyword-Farbe ohne Unterstrich-Animation — ruhiger, weniger "zeigefingerig" */

  /* Bühne: zwei große, weich gerundete Foto-Karten, versetzt */
  .ueber7__stage {
    position: relative;
    min-height: clamp(21rem, 35vw, 27rem);
  }
  .ueber7__frame {
    position: absolute;
    margin: 0;
  }
  .ueber7__frame--a {
    top: 0;
    left: clamp(0px, 4vw, 2rem);
    width: min(19rem, 62%);
    z-index: 1;
  }
  .ueber7__frame--b {
    top: clamp(6.5rem, 16vw, 9.5rem);
    right: 0;
    left: auto;
    width: min(15rem, 50%);
    z-index: 2;
  }

  .ueber7__card {
    position: relative;
    display: block;
    border-radius: 1.75rem;
    overflow: visible;
    box-shadow:
      0 1px 2px rgba(43, 37, 35, 0.07),
      0 22px 40px -18px rgba(43, 37, 35, 0.34);
  }
  .ueber7__photo {
    display: block;
    overflow: hidden;
    border-radius: 1.75rem;
    aspect-ratio: 2 / 3;
    background: var(--paper-dim);
  }
  .ueber7__frame--a .ueber7__photo {
    aspect-ratio: 213 / 320;
  }
  .ueber7__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Basiszustand vor der Enthüllung: entsättigt — die Farb-Ankunft ist
       die eigentliche Bewegung, nicht nur ein Fade. */
    filter: grayscale(1) contrast(1.08) brightness(0.9);
    transform: scale(1.1);
    transition:
      filter 1.1s var(--ease-out),
      transform 1.4s var(--ease-curtain);
    transition-delay: var(--rd, 0s);
  }
  .ueber7__frame[data-reveal].is-in .ueber7__photo :global(img) {
    filter: var(--photo-filter);
    transform: scale(1);
  }

  /* Curtain-Clip zusätzlich zur Duoton-Ankunft */
  .ueber7__frame[data-reveal] .ueber7__photo {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.9s var(--ease-curtain);
    transition-delay: var(--rd, 0s);
  }
  .ueber7__frame[data-reveal].is-in .ueber7__photo {
    clip-path: inset(0 0 0 0);
  }

  .ueber7__frame:hover .ueber7__photo :global(img) {
    transform: scale(1.045);
  }

  /* Schwebender Fakten-Tag, überlappt die untere Kartenkante — Referenz:
     Material-/Service-Badges direkt auf dem Foto statt stiller Caption. */
  .ueber7__tag {
    position: absolute;
    left: 0.9rem;
    bottom: -0.85rem;
    z-index: 1;
    background: var(--oak);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
    border-radius: 999px;
    padding: 0.5rem 1rem;
    box-shadow: 0 10px 18px -8px rgba(43, 37, 35, 0.45);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
    transition-delay: calc(var(--rd, 0s) + 0.55s);
  }
  .ueber7__frame[data-reveal].is-in .ueber7__tag {
    opacity: 1;
    transform: none;
  }

  .ueber7__loc {
    margin-top: 1.4rem;
    max-width: 14rem;
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .ueber7__photo :global(img) {
      filter: var(--photo-filter);
      transform: none;
      transition: none;
    }
    .ueber7__frame[data-reveal] .ueber7__photo {
      clip-path: none;
      transition: none;
    }
    .ueber7__tag {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .ueber7__copy .key::after {
      transform: scaleX(1);
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .ueber7__grid {
      grid-template-columns: 1fr;
      gap: clamp(3.5rem, 10vh, 4.5rem);
    }
    .ueber7__stage {
      min-height: clamp(17rem, 76vw, 21rem);
    }
    .ueber7__frame--a {
      left: 0;
      width: 56%;
    }
    .ueber7__frame--b {
      top: clamp(5rem, 28vw, 6.5rem);
      width: 46%;
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const frames = document.querySelectorAll<HTMLElement>('#ueber-uns-v4 [data-reveal]');
  if (reduced) {
    frames.forEach((f) => f.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.25 },
    );
    frames.forEach((f) => io.observe(f));
  }
</script>
