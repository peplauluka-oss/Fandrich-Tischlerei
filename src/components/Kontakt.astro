---
import KontaktForm from './KontaktForm';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const jahr = 2026;

// OSM-Einbettung erst nach Klick (Two-Click, DSGVO-konform)
const bbox = `${site.geo.lng - 0.008},${site.geo.lat - 0.004},${site.geo.lng + 0.008},${site.geo.lat + 0.004}`;
const osmSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${site.geo.lat},${site.geo.lng}`;
const osmLink = `https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lng}#map=16/${site.geo.lat}/${site.geo.lng}`;
---

<section class="section closing on-ink" id="kontakt-v3" aria-label="Kontakt">
  <div class="wrap">
    <div class="closing__top">
      <div class="closing__info">
        <div class="section-head">
          <p class="eyebrow reveal"><span class="eyebrow__idx">(06)</span>Kontakt</p>
          <h2 class="headline split">Erzählen Sie uns von Ihrem Projekt.</h2>
        </div>
        <address class="reveal">
          <p>
            Tischlerei {site.name}<br />
            {site.street}<br />
            {site.zip} {site.city}
          </p>
          <p class="closing__hours">{site.openingHours}</p>
          {
            /* E-Mail nur, falls verifiziert — sonst Telefon-CTA */
            site.email ? (
              <p>
                <a href={`mailto:${site.email}`} class="link-line">
                  {site.email}
                </a>
              </p>
            ) : (
              <a href={`tel:${site.phoneHref}`} class="btn btn--oak closing__tel" data-cursor="link">
                {site.phone} <span class="arrow" aria-hidden="true">→</span>
              </a>
            )
          }
        </address>
      </div>

      <div class="closing__form reveal" style="--reveal-delay: 0.1s">
        <KontaktForm client:visible />
      </div>
    </div>

    <div class="closing__map reveal" data-map>
      <div class="map__placeholder">
        <p class="map__label">Treseburger Straße 30, 13129 Berlin-Pankow</p>
        <button type="button" class="btn btn--paper" data-map-load>
          Karte laden <span class="arrow" aria-hidden="true">→</span>
        </button>
        <p class="map__hint">
          Beim Laden wird eine Verbindung zu OpenStreetMap hergestellt.
          <a href={`${base}/datenschutz`} class="link-static">Hinweise zum Datenschutz</a>
        </p>
      </div>
    </div>
  </div>

  <div class="closing__wordmark" aria-hidden="true">FANDRICH</div>

  <div class="wrap closing__foot">
    <div class="closing__legal">
      <a href={`${base}/impressum`} class="link-line">Impressum</a>
      <a href={`${base}/datenschutz`} class="link-line">Datenschutz</a>
    </div>
    <p class="closing__copy">
      © {site.name} {jahr}
      <span class="closing__stamp">Stand: {import.meta.env.PUBLIC_BUILD_STAMP}</span>
    </p>
  </div>
</section>

<style>
  .closing {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    overflow: hidden;
    padding-bottom: 0;
  }

  .closing .eyebrow {
    color: var(--oak);
  }

  .closing__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }

  address {
    font-style: normal;
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: rgba(250, 247, 242, 0.82);
  }

  address a {
    line-height: 2;
  }

  .closing__hours {
    color: rgba(250, 247, 242, 0.55);
    font-size: 0.95rem;
  }

  .closing__tel {
    margin-top: 0.5rem;
  }

  /* Two-Click-Karte */
  .closing__map {
    margin-top: clamp(3.5rem, 8vh, 6rem);
  }

  .map__placeholder,
  .closing__map :global(iframe) {
    width: 100%;
    height: clamp(16rem, 40vh, 22rem);
    border: 0;
  }

  .map__placeholder {
    background: rgba(250, 247, 242, 0.05);
    border: 1px solid var(--oak-line);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    text-align: center;
    padding: var(--gutter);
  }

  .map__label {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.6);
  }

  .map__hint {
    font-size: 0.8rem;
    color: rgba(250, 247, 242, 0.55);
    max-width: 44ch;
  }

  /* Riesiges Schlussbild: FANDRICH über die volle Breite */
  .closing__wordmark {
    margin-top: clamp(4rem, 10vh, 8rem);
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(4rem, 14vw, 12rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
    text-align: center;
    color: var(--paper);
    opacity: 0.1;
    user-select: none;
    white-space: nowrap;
  }

  .closing__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-block: clamp(2rem, 5vh, 3rem);
    border-top: 1px solid var(--oak-line);
  }

  .closing__legal {
    display: flex;
    gap: 1.75rem;
    font-size: 0.95rem;
  }

  .closing__copy {
    font-size: 0.9rem;
    color: rgba(250, 247, 242, 0.55);
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .closing__stamp {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    /* 0.6 statt 0.4 → Kontrast 6:1 auf --ink (WCAG AA erfüllt) */
    color: rgba(250, 247, 242, 0.6);
  }

  @media (max-width: 899px) {
    .closing__top {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ osmSrc, osmLink }}>
  const map = document.querySelector('[data-map]');
  const btn = document.querySelector('[data-map-load]');
  if (map && btn) {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = osmSrc;
      iframe.title = 'Karte: Tischlerei Fandrich, Treseburger Straße 30, 13129 Berlin';
      iframe.loading = 'lazy';
      const link = document.createElement('p');
      link.className = 'map__hint';
      link.style.marginTop = '0.75rem';
      link.innerHTML = `<a href="${osmLink}" target="_blank" rel="noopener" class="link-static">Größere Karte auf openstreetmap.org öffnen</a>`;
      map.replaceChildren(iframe, link);
    });
  }
</script>
