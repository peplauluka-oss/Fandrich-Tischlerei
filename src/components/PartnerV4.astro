---
/**
 * Partner & Auftraggeber — Logo-Wall (Schritt 7).
 * Echte Logos statt Wortmarken, als ein System: im Ruhezustand monochrom
 * (grayscale), bei Hover in Originalfarbe mit sanftem Anheben (Emil).
 * Kein Eyebrow, keine Deko-Nummer (impeccable). Helle Logos werden
 * invertiert, damit sie auf dem hellen Kachel-Grund sichtbar bleiben.
 */
import { logoPartner, weiterePartner } from '../data/partners';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="partner" id="partner-v4" aria-label="Partner und Auftraggeber">
  <div class="wrap">
    <div class="partner__head">
      <h2 class="headline--v4 split">In guter Gesellschaft.</h2>
      <p class="partner__intro reveal" style="--reveal-delay: 0.05s">
        Berliner Hausverwaltungen, Wohnungsunternehmen und Handwerksbetriebe arbeiten seit
        Jahren mit uns — vom einzelnen Auftrag bis zur laufenden Betreuung ganzer Objekte.
      </p>
    </div>

    <ul class="partner__wall reveal" style="--reveal-delay: 0.1s">
      {
        logoPartner.map((p, i) => (
          <li>
            <a
              class="partner__tile"
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={p.name}
              data-cursor="link"
              style={`--i: ${i}`}
            >
              <img
                class={`partner__logo${p.invert ? ' is-invert' : ''}`}
                src={`${base}/${p.logo}`}
                alt={p.name}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="partner__more reveal" style="--reveal-delay: 0.16s">
      Außerdem u. a. {weiterePartner.join(' · ')}
    </p>
  </div>
</section>

<style>
  .partner {
    padding-block: var(--section-gap);
  }
  .partner__head {
    max-width: 46ch;
    margin-bottom: clamp(2.25rem, 5vh, 3.25rem);
  }
  .partner__intro {
    margin-top: clamp(1.1rem, 3vh, 1.6rem);
    color: var(--ink-soft);
  }

  /* -------- Logo-Wall -------- */
  /* Zentriertes Flex-Raster: 9 Logos brechen als ausgewogene 5 + 4 um,
     die letzte Reihe bleibt mittig statt links angeschlagen. */
  .partner__wall {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(0.55rem, 1vw, 0.85rem);
  }
  .partner__wall > li {
    /* Zielbreite so, dass 11 Logos als volle 6 + 5 umbrechen (kein Einzel-Waisenkind) */
    flex: 0 1 clamp(8.5rem, 14vw, 10.75rem);
  }

  .partner__tile {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 5.5rem;
    padding: 1.1rem 1.35rem;
    background: var(--paper);
    border: 1px solid var(--oak-line);
    border-radius: 14px;
    /* nur transform/opacity/farb-relevante Props animieren (Emil) */
    transition:
      transform 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  .partner__logo {
    max-height: 2.5rem;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    /* Ruhezustand: ein System — monochrom, zurückgenommen */
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter 0.35s var(--ease-out),
      opacity 0.35s var(--ease-out);
  }
  /* Helle Logos (weiß auf transparent) sichtbar machen: zu Ink invertieren */
  .partner__logo.is-invert {
    filter: grayscale(1) invert(1);
    opacity: 0.72;
  }

  @media (hover: hover) and (pointer: fine) {
    .partner__tile:hover {
      transform: translateY(-3px);
      border-color: var(--oak);
      box-shadow: 0 16px 30px -20px rgba(43, 37, 35, 0.45);
    }
    .partner__tile:hover .partner__logo {
      filter: grayscale(0);
      opacity: 1;
    }
    /* invertierte Logos haben keine nutzbare Farbversion: dunkel + voll */
    .partner__tile:hover .partner__logo.is-invert {
      filter: grayscale(1) invert(1);
      opacity: 1;
    }
  }

  /* Press-Feedback (Emil) */
  .partner__tile:active {
    transform: scale(0.985);
  }
  .partner__tile:focus-visible {
    outline: 2px solid var(--oak);
    outline-offset: 3px;
  }

  .partner__more {
    margin-top: clamp(1.5rem, 3.5vh, 2.25rem);
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink-soft);
    opacity: 0.72;
    max-width: 60ch;
  }

  @media (max-width: 640px) {
    .partner__wall > li {
      flex: 0 1 calc(50% - 0.3rem);
    }
    .partner__tile {
      min-height: 4.75rem;
      padding: 0.9rem;
    }
    .partner__logo {
      max-height: 2.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .partner__tile,
    .partner__logo {
      transition: none;
    }
  }
</style>
