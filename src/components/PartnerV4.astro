---
/**
 * Partner & Auftraggeber — moderne „Logo-Wall" als Trust-Sektion.
 * Statt monotoner Linkliste: gruppierte Karten mit Wortmarke (oder echtem
 * Logo, sobald geliefert), monochrom, Hover hebt an + färbt Oak.
 * Un-nummerierte Band-Sektion (wie CtaBand) — reiht sich vor dem Q&A ein,
 * ohne die Kapitel-Nummerierung zu verschieben.
 */
import { auftraggeber, partnerBetriebe } from '../data/partners';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const gruppen = [
  { label: 'Hausverwaltungen & Auftraggeber', items: auftraggeber },
  { label: 'Partnerbetriebe', items: partnerBetriebe },
];
---

<section class="partner section--warm" id="partner-v4" aria-label="Partner und Auftraggeber">
  <div class="wrap">
    <div class="partner__head">
      <p class="eyebrow reveal">Partner &amp; Referenzen</p>
      <h2 class="headline--v4 split">In guter Gesellschaft.</h2>
      <p class="partner__intro reveal" style="--reveal-delay: 0.05s">
        Wir arbeiten Hand in Hand mit Berliner Handwerksbetrieben — und fertigen für
        Hausverwaltungen und Auftraggeber in der ganzen Stadt.
      </p>
    </div>

    {
      gruppen.map((g, gi) => (
        <div class="partner__group reveal" style={`--reveal-delay: ${0.1 + gi * 0.05}s`}>
          <h3 class="partner__label">{g.label}</h3>
          <ul class="partner__grid">
            {g.items.map((p) => (
              <li>
                <a
                  class="partner__card"
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cursor="link"
                >
                  {p.logo ? (
                    <img
                      class="partner__logo"
                      src={`${base}/${p.logo}`}
                      alt={p.name}
                      loading="lazy"
                    />
                  ) : (
                    <span class="partner__name">{p.name}</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .partner {
    padding-block: var(--section-gap);
  }
  .partner__head {
    max-width: 52ch;
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }
  .partner__intro {
    margin-top: clamp(1.25rem, 3vh, 1.75rem);
    color: var(--ink-soft);
  }

  .partner__group + .partner__group {
    margin-top: clamp(2.5rem, 5vh, 3.5rem);
  }
  .partner__label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oak);
    margin-bottom: 1.1rem;
  }

  .partner__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: clamp(0.6rem, 1.2vw, 0.9rem);
  }

  .partner__card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 5.5rem;
    padding: 1rem 1.25rem;
    background: var(--paper);
    border: 1px solid var(--oak-line);
    border-radius: 0.9rem;
    text-decoration: none;
    text-align: center;
    transition:
      color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      transform 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
  }
  .partner__name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--ink-soft);
    transition: color 0.25s var(--ease-out);
  }
  /* Echte Logos: monochrom im Ruhezustand, Farbe bei Hover (Logo-Wall-Look) */
  .partner__logo {
    max-height: 2.4rem;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      filter 0.25s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }

  @media (hover: hover) {
    .partner__card:hover {
      border-color: var(--oak);
      transform: translateY(-3px);
      box-shadow: 0 14px 26px -16px rgba(43, 37, 35, 0.4);
    }
    .partner__card:hover .partner__name {
      color: var(--ink);
    }
    .partner__card:hover .partner__logo {
      filter: none;
      opacity: 1;
    }
  }
  .partner__card:focus-visible {
    outline: 2px solid var(--oak);
    outline-offset: 2px;
  }

  @media (max-width: 520px) {
    .partner__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .partner__card {
      min-height: 4.75rem;
      padding: 0.85rem;
    }
    .partner__name {
      font-size: 0.9rem;
    }
  }
</style>
