---
import { Image } from 'astro:assets';
import { ueberUnsImages } from '../data/images';

// Versetztes Bildpaar aus der zentralen Zuordnung (jedes Foto genau 1×).
// Es existiert KEIN MITTEL/GROSS-Porträt (STATUS.md) — deshalb die zwei
// stärksten KLEIN-Hochformate bei ≤ 284 px (native ÷ 1.5), was dem Bild-Gesetz
// als Thumbnailgröße (≤ 320 px) entspricht.
// TODO: durch Originale in hoher Auflösung ersetzen (nur images.ts tauschen).
const [a, b] = ueberUnsImages;
---

<section class="section ueber" id="ueber-uns-v3" aria-label="Über uns">
  <div class="wrap ueber__grid">
    <div class="ueber__text">
      <div class="section-head">
        <span class="section-num" data-num="01" aria-hidden="true"></span>
        <p class="eyebrow reveal">Über uns</p>
        <h2 class="headline split">Vom Aufmaß bis zur Montage.</h2>
      </div>
      <p class="ueber__lead reveal">
        Wir sind eine Meistertischlerei in Berlin-Pankow. Vom ersten Aufmaß bis zur Montage
        entsteht alles in unserer eigenen Werkstatt — Einbaumöbel, Restaurierungen, Innenausbau.
        Wir arbeiten mit Massivholz und ausgesuchten Furnieren, und dort, wo es das Möbel verlangt,
        mit handgeschnittenen Verbindungen. Was wir bauen, soll bleiben.
      </p>
      <a href="#werkstatt-v3" class="link-line ueber__more reveal" style="--reveal-delay: 0.1s">
        Mehr über die Werkstatt
      </a>
    </div>

    <div class="ueber__pair" data-ueber-pair>
      <figure class="ueber__fig ueber__fig--a" data-clip style="--d: 0s">
        <div class="photo ueber__frame ueber__frame--a">
          <Image
            src={a.src}
            alt={a.alt}
            widths={[284, a.src.width]}
            sizes="(min-width: 900px) 17rem, 42vw"
            loading="eager"
            quality={80}
          />
        </div>
        <figcaption>{a.caption}</figcaption>
      </figure>

      <figure class="ueber__fig ueber__fig--b" data-clip style="--d: 0.15s">
        <div class="photo ueber__frame ueber__frame--b">
          <Image
            src={b.src}
            alt={b.alt}
            widths={[284, b.src.width]}
            sizes="(min-width: 900px) 17rem, 42vw"
            loading="eager"
            quality={80}
          />
        </div>
        <figcaption>{b.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .ueber__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .ueber__lead {
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
    font-size: 1.15rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  .ueber__more {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Versetztes Bildpaar */
  .ueber__pair {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .ueber__fig {
    margin: 0;
    width: 17rem;
    max-width: 42vw;
  }

  .ueber__fig--b {
    margin-top: 64px;
  }

  .ueber__frame {
    overflow: hidden;
  }

  .ueber__frame--a {
    aspect-ratio: 4 / 5;
  }

  .ueber__frame--b {
    aspect-ratio: 3 / 4;
  }

  .ueber__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ueber__fig figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.9rem;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .ueber__fig figcaption::before {
    content: '';
    flex: none;
    width: 1.75rem;
    height: 1px;
    background: var(--oak);
  }

  /* Clip-Path-Reveal auf dem inneren Rahmen (nicht auf der beobachteten Figur —
     sonst kollabiert die IntersectionObserver-Ratio auf 0). */
  .ueber__fig[data-clip] .ueber__frame {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.8s var(--ease-out);
    transition-delay: var(--d, 0s);
  }

  .ueber__fig[data-clip] figcaption {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
    transition-delay: calc(var(--d, 0s) + 0.15s);
  }

  .ueber__fig[data-clip].is-in .ueber__frame {
    clip-path: inset(0 0 0 0);
  }

  .ueber__fig[data-clip].is-in figcaption {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .ueber__fig[data-clip] .ueber__frame {
      clip-path: none;
      transition: none;
    }
    .ueber__fig[data-clip] figcaption {
      opacity: 1;
    }
  }

  @media (max-width: 899px) {
    .ueber__grid {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 7vh, 4rem);
    }
    .ueber__pair {
      justify-content: flex-start;
    }
    .ueber__fig {
      width: 42vw;
    }
  }
</style>

<script>
  // Selbstständiger Clip-Reveal für das Bildpaar (unabhängig vom globalen
  // Reveal-System, das hier nicht zuverlässig ausgelöst hat).
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const figs = document.querySelectorAll<HTMLElement>('[data-ueber-pair] [data-clip]');
  if (reduced) {
    figs.forEach((f) => f.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2 },
    );
    figs.forEach((f) => io.observe(f));
  }
</script>
