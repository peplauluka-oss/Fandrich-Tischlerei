---
import KontaktForm from './KontaktForm';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const jahr = 2026;

const bbox = `${site.geo.lng - 0.008},${site.geo.lat - 0.004},${site.geo.lng + 0.008},${site.geo.lat + 0.004}`;
const osmSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${site.geo.lat},${site.geo.lng}`;
const osmLink = `https://www.openstreetmap.org/?mlat=${site.geo.lat}&mlon=${site.geo.lng}#map=16/${site.geo.lat}/${site.geo.lng}`;
---

<section class="kontakt4 section--ink" id="kontakt-v4" aria-label="Kontakt">
  <div class="wrap kontakt4__split">
    <div class="kontakt4__left">
      <p class="eyebrow reveal"><span class="eyebrow__idx">(06)</span>Kontakt</p>
      <h2 class="headline--v4 reveal">Erzählen Sie uns von Ihrem Projekt.</h2>

      <address class="kontakt4__nap reveal" style="--reveal-delay: 0.05s">
        <p>
          Tischlerei {site.name}<br />
          {site.street}<br />
          {site.zip} {site.city}
        </p>
        <p class="kontakt4__hours">{site.openingHours}</p>
        <a href={`tel:${site.phoneHref}`} class="kontakt4__tel" data-cursor="link">
          {site.phone} <span class="arrow" aria-hidden="true">→</span>
        </a>
      </address>
    </div>

    <div class="kontakt4__right reveal" style="--reveal-delay: 0.1s">
      <KontaktForm client:visible />
    </div>
  </div>

  <div class="wrap kontakt4__map reveal" data-map>
    <div class="map__placeholder">
      <p class="map__label">Treseburger Straße 30, 13129 Berlin-Pankow</p>
      <button type="button" class="btn btn--paper" data-map-load>
        Karte laden <span class="arrow" aria-hidden="true">→</span>
      </button>
      <p class="map__hint">
        Beim Laden wird eine Verbindung zu OpenStreetMap hergestellt.
        <a href={`${base}/datenschutz`} class="link-static">Hinweise zum Datenschutz</a>
      </p>
    </div>
  </div>

  <div class="kontakt4__wordmark" aria-hidden="true">FANDRICH</div>

  <div class="wrap kontakt4__foot">
    <div class="kontakt4__legal">
      <a href={`${base}/impressum`} class="link-line">Impressum</a>
      <a href={`${base}/datenschutz`} class="link-line">Datenschutz</a>
    </div>
    <p class="kontakt4__copy">
      © {site.name} {jahr}
      <span class="kontakt4__stamp">Stand: {import.meta.env.PUBLIC_BUILD_STAMP}</span>
    </p>
  </div>
</section>

<style>
  .kontakt4 {
    position: relative;
    overflow: hidden;
    padding-bottom: 0;
  }
  .kontakt4__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 7vw, 6rem);
    align-items: start;
  }
  .kontakt4__nap {
    font-style: normal;
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: rgba(250, 247, 242, 0.82);
  }
  .kontakt4__hours {
    color: rgba(250, 247, 242, 0.55);
    font-size: 0.95rem;
  }
  .kontakt4__tel {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    color: var(--oak);
    text-decoration: none;
    margin-top: 0.5rem;
  }

  /* Formular auf dunklem Grund: Underline hell, Fokus --oak */
  .kontakt4__right :global(.form input),
  .kontakt4__right :global(.form textarea) {
    color: var(--paper);
    border-bottom-color: rgba(250, 247, 242, 0.4);
  }
  .kontakt4__right :global(.form label) {
    color: rgba(250, 247, 242, 0.6);
  }
  .kontakt4__right :global(.form input:focus),
  .kontakt4__right :global(.form textarea:focus) {
    border-bottom-color: var(--oak);
  }
  .kontakt4__right :global(.btn) {
    background: var(--oak);
    color: var(--ink);
  }

  .kontakt4__map {
    margin-top: clamp(3.5rem, 8vh, 6rem);
  }
  .map__placeholder,
  .kontakt4__map :global(iframe) {
    width: 100%;
    height: clamp(16rem, 40vh, 22rem);
    border: 0;
  }
  .map__placeholder {
    background: rgba(250, 247, 242, 0.05);
    border: 1px solid var(--oak-line);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    text-align: center;
    padding: var(--gutter);
  }
  .map__label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(250, 247, 242, 0.6);
  }
  .map__hint {
    font-size: 0.8rem;
    color: rgba(250, 247, 242, 0.55);
    max-width: 44ch;
  }

  .kontakt4__wordmark {
    margin-top: clamp(4rem, 10vh, 8rem);
    font-family: var(--font-head);
    font-weight: 340;
    font-size: clamp(4rem, 14vw, 12rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
    text-align: center;
    color: var(--paper);
    opacity: 0.1;
    user-select: none;
    white-space: nowrap;
  }

  .kontakt4__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-block: clamp(2rem, 5vh, 3rem);
    border-top: 1px solid var(--oak-line);
  }
  .kontakt4__legal {
    display: flex;
    gap: 1.75rem;
    font-size: 0.95rem;
  }
  .kontakt4__copy {
    font-size: 0.9rem;
    color: rgba(250, 247, 242, 0.55);
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .kontakt4__stamp {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgba(250, 247, 242, 0.6);
  }

  @media (max-width: 899px) {
    .kontakt4__split {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>

<script define:vars={{ osmSrc, osmLink }}>
  const map = document.querySelector('#kontakt-v4 [data-map]');
  const btn = document.querySelector('#kontakt-v4 [data-map-load]');
  if (map && btn) {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = osmSrc;
      iframe.title = 'Karte: Tischlerei Fandrich, Treseburger Straße 30, 13129 Berlin';
      iframe.loading = 'lazy';
      const link = document.createElement('p');
      link.className = 'map__hint';
      link.style.marginTop = '0.75rem';
      link.innerHTML = `<a href="${osmLink}" target="_blank" rel="noopener" class="link-static">Größere Karte auf openstreetmap.org öffnen</a>`;
      map.replaceChildren(iframe, link);
    });
  }
</script>
