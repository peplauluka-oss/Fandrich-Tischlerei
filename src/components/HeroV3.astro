---
import { Image } from 'astro:assets';
import { heroVideos, heroPoster, heroAlt } from '../data/heroMedia';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasVideo = heroVideos.length > 0;
---

<section class="herov3" id="hero-v3" aria-label="Intro">
  <!-- VideoSlot: Clips wenn vorhanden, sonst Ken-Burns-Poster -->
  <div class="herov3__media">
    {
      hasVideo ? (
        heroVideos.map((v, i) => (
          <video
            class:list={['herov3__video', { 'is-first': i === 0 }]}
            autoplay
            muted
            loop={heroVideos.length === 1}
            playsinline
            preload={i === 0 ? 'auto' : 'none'}
            data-hero-video
          >
            {v.webm && <source src={`${base}/${v.webm}`} type="video/webm" />}
            {v.mp4 && <source src={`${base}/${v.mp4}`} type="video/mp4" />}
          </video>
        ))
      ) : (
        <Image
          class="herov3__poster"
          src={heroPoster}
          alt={heroAlt}
          widths={[Math.round(heroPoster.width / 2), heroPoster.width]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
        />
      )
    }
  </div>

  <div class="herov3__scrim" aria-hidden="true"></div>

  <div class="herov3__content wrap">
    <p class="herov3__eyebrow herov3__line" style="--d: 0s">
      Tischlerei &amp; Möbelrestaurierung — Berlin Pankow
    </p>
    <h1 class="herov3__title">
      <span class="herov3__line" style="--d: 0.1s">Handwerk,</span>
      <span class="herov3__line" style="--d: 0.2s">das bleibt.</span>
    </h1>
    <p class="herov3__sub herov3__line" style="--d: 0.3s">
      Möbel nach Maß, Restaurierung und Innenausbau — gefertigt in unserer Werkstatt in Pankow.
    </p>
    <div class="herov3__line" style="--d: 0.4s">
      <a href="#kontakt-v3" class="btn btn--oak herov3__cta" data-cursor="link">
        Projekt anfragen <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <span class="herov3__scrollhint" aria-hidden="true"></span>
</section>

<style>
  .herov3 {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: clip;
    display: flex;
    align-items: flex-end;
    color: var(--paper);
  }

  .herov3__media {
    position: absolute;
    inset: 0;
    background: var(--ink);
  }

  .herov3__poster,
  .herov3__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  /* Ken-Burns: 1.0 → 1.08, 14s, ease-out, einmalig */
  .herov3__poster {
    transform-origin: 60% 45%;
    animation: kenburns 14s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  /* Video-Crossfade (dormant bis Clips vorliegen) */
  .herov3__video {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .herov3__video.is-first,
  .herov3__video.is-active {
    opacity: 1;
  }

  /* Warmer Serienlook auch im Hero */
  .herov3__media :global(img),
  .herov3__video {
    filter: var(--photo-filter);
  }

  /* Verlauf von unten: rgba(43,37,35,.65) → transparent @60% */
  .herov3__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(43, 37, 35, 0.4) 0%, rgba(43, 37, 35, 0) 22%),
      linear-gradient(to top, rgba(43, 37, 35, 0.68) 0%, rgba(43, 37, 35, 0) 60%),
      linear-gradient(105deg, rgba(43, 37, 35, 0.42) 0%, rgba(43, 37, 35, 0) 46%);
  }

  .herov3__content {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(3.5rem, 9vh, 6.5rem);
  }

  .herov3__eyebrow {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--oak);
    margin-bottom: 1.25rem;
  }

  .herov3__title {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.8rem, 9vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--paper);
    margin: 0;
    text-wrap: balance;
  }

  .herov3__sub {
    margin-top: 1.5rem;
    max-width: 42ch;
    font-size: 1.1rem;
    color: rgba(250, 247, 242, 0.9);
  }

  .herov3__cta {
    margin-top: 2.25rem;
  }

  /* Zeilen-Reveal (CSS-only, no-JS-sicher): Inhalt animiert beim Laden hoch.
     Ohne CSS-Animationen bleibt der Endzustand sichtbar. */
  .herov3__line {
    display: block;
    animation: hero-line 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes hero-line {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Scroll-Hinweis: 1px-Linie, pulsiert */
  .herov3__scrollhint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    width: 1px;
    height: 40px;
    background: var(--paper);
    opacity: 0.6;
    transform-origin: top;
    animation: hint-pulse 2.6s ease-in-out infinite;
  }

  @keyframes hint-pulse {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.3;
    }
    50% {
      transform: scaleY(1);
      opacity: 0.6;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .herov3__poster,
    .herov3__line,
    .herov3__scrollhint {
      animation: none;
    }
    .herov3__line {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Dezenter Scroll-Parallax des Hintergrunds (transform only, rAF).
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const media = document.querySelector<HTMLElement>('.herov3__media');
    const hero = document.querySelector<HTMLElement>('.herov3');
    if (media && hero) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const y = Math.min(window.scrollY * 0.18, 90);
        media.style.transform = `translateY(${y}px)`;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
    }
  }
</script>
