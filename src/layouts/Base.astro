---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { galerieImages } from '../data/images';

interface Props {
  title: string;
  description: string;
  /** Unterseiten (Impressum etc.) nicht in den Index */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// OG-Image: stärkstes Galerie-Motiv (IMG_2479 wird in v4 nirgends verwendet)
const ogImage = await getImage({
  src: galerieImages[0]!.src,
  width: 1200,
  format: 'jpeg',
});
const ogImageUrl = new URL(ogImage.src, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Feines Noise-Overlay als data-URI (feTurbulence) — keine externe Ressource
const grainSvg = `<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>`;
const grainUri = `url("data:image/svg+xml,${grainSvg}")`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Carpenter',
  name: `Tischlerei ${site.name}`,
  description:
    'Meistertischlerei in Berlin-Pankow: Möbel nach Maß, Möbelrestaurierung und Innenausbau.',
  url: Astro.site?.href,
  telephone: site.phoneHref,
  // TODO: email + foundingDate ergänzen, sobald verifiziert (src/data/site.ts)
  ...(site.email ? { email: site.email } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.zip,
    addressLocality: site.city,
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHours: site.openingHoursSchema, // TODO: echte Öffnungszeiten
  areaServed: { '@type': 'City', name: 'Berlin' },
  image: ogImageUrl.href,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`}
      type="image/svg+xml"
    />
    <meta name="theme-color" content="#2B2523" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`Tischlerei ${site.name}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="grain" aria-hidden="true" style={`--grain-uri: ${grainUri}`}></div>

    <div class="cursor" aria-hidden="true">
      <span class="cursor__dot"></span>
      <span class="cursor__label">Ansehen</span>
    </div>

    <button class="totop" type="button" aria-label="Zum Seitenanfang" data-totop hidden>
      <span aria-hidden="true">↑</span>
    </button>

    <slot />

    <script src="../scripts/stage.ts"></script>
  </body>
</html>
