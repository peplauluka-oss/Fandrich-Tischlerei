---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { galerieImages } from '../data/images';
import woodTex from '../assets/textures/holz-kiefer.jpeg';

interface Props {
  title: string;
  description: string;
  /** Unterseiten (Impressum etc.) nicht in den Index */
  noindex?: boolean;
  /** Zusätzliche JSON-LD-Knoten (z. B. Service, BreadcrumbList, FAQPage). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, schema } = Astro.props;
const extraSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// OG-Image: stärkstes Galerie-Motiv (IMG_2479 wird in v4 nirgends verwendet)
const ogImage = await getImage({
  src: galerieImages[0]!.src,
  width: 1200,
  format: 'jpeg',
});
const ogImageUrl = new URL(ogImage.src, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);

// Vollflächen-Holztextur als WebP (auf jeder Seite -> Bandbreite/LCP schonen).
const woodWebp = await getImage({ src: woodTex, width: 1600, format: 'webp', quality: 70 });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Carpenter',
  '@id': `${Astro.site?.href}#business`,
  name: `Tischlerei ${site.name}`,
  description:
    'Meistertischlerei in Berlin-Pankow für Möbel nach Maß, Möbelrestaurierung, Fenster- und Türreparatur — tätig in ganz Berlin und Umgebung.',
  url: Astro.site?.href,
  telephone: site.phoneHref,
  priceRange: '€€',
  // TODO: email + foundingDate ergänzen, sobald verifiziert (src/data/site.ts)
  ...(site.email ? { email: site.email } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    postalCode: site.zip,
    addressLocality: site.city,
    addressRegion: site.district,
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:00',
      closes: '16:00',
    },
  ],
  // Einsatzgebiet: ganz Berlin + naher Brandenburg-Rand („Berlin und Umgebung")
  areaServed: [
    { '@type': 'City', name: 'Berlin' },
    { '@type': 'AdministrativeArea', name: 'Berliner Umland (Brandenburg)' },
  ],
  image: ogImageUrl.href,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical.href} />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`}
      type="image/svg+xml"
    />
    <meta name="theme-color" content="#2B2523" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`Tischlerei ${site.name}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      extraSchema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>
  <body>
    <span class="scroll-progress" aria-hidden="true" data-scroll-progress></span>
    <div class="woodbg" aria-hidden="true" style={`--wood-tex: url(${woodWebp.src})`}></div>

    <div class="cursor" aria-hidden="true">
      <span class="cursor__dot"></span>
      <span class="cursor__label">Ansehen</span>
    </div>

    <button class="totop" type="button" aria-label="Zum Seitenanfang" data-totop hidden>
      <span aria-hidden="true">↑</span>
    </button>

    <slot />

    <script src="../scripts/stage.ts"></script>
  </body>
</html>
